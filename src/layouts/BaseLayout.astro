---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "CV", description = "CV" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Marchează că JS e activ: animațiile de apariție pornesc doar atunci -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Asamblează emailul în browser (nu există întreg în HTML-ul livrat)
      document.querySelectorAll<HTMLAnchorElement>("[data-mail]").forEach((a) => {
        const email = `${a.dataset.u}@${a.dataset.d}`;
        a.href = `mailto:${email}`;
        if (a.hasAttribute("data-mail-text")) a.textContent = email;
      });
    </script>
  </body>
</html>
