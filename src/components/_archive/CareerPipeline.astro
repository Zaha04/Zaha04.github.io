---
/**
 * „Cast my story” ca un pipeline de date (DAG, stil Airflow).
 * Fiecare rol / certificare = un task; dependențele (`after`) dau forma grafului.
 * ▶ Trigger DAG → task-urile rulează pe rând (queued → running → success), log-urile curg în consolă.
 * Ultimul task, deploy_to_your_team, așteaptă aprobarea vizitatorului → contact + CV.
 */
import { timeline, typeLabels, profile } from "../data/cv";

const entries = [...timeline].sort((a, b) => a.start.localeCompare(b.start));
const DEPLOY = "deploy_to_your_team";

type Task = {
  id: string; after: string[]; level: number; year: string; short: string;
  logs: string[]; e?: (typeof entries)[number];
};
const tasks: Task[] = entries.map((e) => ({
  id: e.taskId ?? e.title.toLowerCase().replace(/[^a-z0-9]+/g, "_"),
  after: e.after ?? [],
  level: 0,
  year: e.start.slice(0, 4),
  short: e.short ?? e.org,
  e,
  logs: [
    `Starting task — ${e.title} @ ${e.org} (${e.period})`,
    ...(e.highlights?.slice(0, 2) ?? [e.summary]).map((h) => `✓ ${h.length > 110 ? h.slice(0, 107).trimEnd() + "…" : h}`),
    `Task exited with return code 0 — SUCCESS`,
  ],
}));
// ultimul task: depinde de rolul curent (ultimul din listă)
tasks.push({
  id: DEPLOY, after: [tasks[tasks.length - 1].id], level: 0, year: "now", short: "Your team",
  logs: [`deploy_to_your_team is waiting for manual approval…`],
});
// nivelul = cel mai lung drum de la început (coloana din graf)
const byId = new Map(tasks.map((t) => [t.id, t]));
const levelOf = (t: Task): number => (t.after.length ? 1 + Math.max(...t.after.map((a) => levelOf(byId.get(a)!))) : 0);
tasks.forEach((t) => (t.level = levelOf(t)));
const levels = Array.from({ length: Math.max(...tasks.map((t) => t.level)) + 1 }, (_, l) => tasks.filter((t) => t.level === l));
const edges = tasks.flatMap((t) => t.after.map((a) => ({ from: a, to: t.id })));

const dagData = JSON.stringify(tasks.map(({ id, after, logs, year }) => ({ id, after, logs, year })));
---

<section id="journey" class="pipe-sec" data-pipe>
  <div class="container head">
    <h2>Cast my story</h2>
    <p class="lead">My career, run as a data pipeline. Trigger the DAG, watch each task run — then approve the final deploy.</p>
  </div>

  <div class="pipe-wrap">
    <!-- ===== Fereastra DAG-ului ===== -->
    <div class="dag-window">
      <div class="dag-bar">
        <div class="dag-title">
          <span class="dag-icon" aria-hidden="true">⛓</span>
          <code>career_pipeline</code>
          <span class="sched">@career · since {tasks[0].year}</span>
          <span class="run-state" data-run-state>idle</span>
        </div>
        <div class="dag-actions">
          <button type="button" class="btn primary trigger" data-trigger>▶ Trigger DAG</button>
          <button type="button" class="text-btn" data-show-all>Show all</button>
          <button type="button" class="text-btn" data-reset hidden>Reset</button>
        </div>
      </div>

      <div class="skill-status" data-skill-status hidden aria-live="polite">
        <span>Highlighting <strong data-skill-name></strong> — <span data-skill-count></span></span>
        <button type="button" class="text-btn" data-clear-skill>Clear ✕</button>
      </div>

      <!-- graful: coloane = niveluri; liniile se desenează din JS după pozițiile reale -->
      <div class="dag" data-dag>
        <svg class="edges" data-edges aria-hidden="true">
          <defs>
            <marker id="dag-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" class="arrow" />
            </marker>
          </defs>
          {edges.map((ed) => <path class="edge" data-from={ed.from} data-to={ed.to} marker-end="url(#dag-arrow)" d="M0 0" />)}
        </svg>
        {edges.map((ed) => <span class="packet" data-pfrom={ed.from} data-pto={ed.to} aria-hidden="true"></span>)}

        {levels.map((lv) => (
          <div class="level">
            {lv.map((t) => (
              <button
                type="button"
                class:list={["task", { "task--deploy": t.id === DEPLOY, "task--cert": t.e?.type === "certification" }]}
                data-task={t.id}
                data-state="none"
                data-tags={(t.e?.tags ?? []).map((x) => x.toLowerCase()).join("|")}
              >
                <span class="t-icon" aria-hidden="true"></span>
                <span class="t-body">
                  <code class="t-id">{t.id}</code>
                  <span class="t-meta">{t.short} · {t.year}</span>
                </span>
                <span class="sr" data-sr>not started</span>
              </button>
            ))}
          </div>
        ))}
      </div>
      <div class="legend" aria-hidden="true">
        <span><i class="lg lg--none"></i>no status</span>
        <span><i class="lg lg--queued"></i>queued</span>
        <span><i class="lg lg--running"></i>running</span>
        <span><i class="lg lg--success"></i>success</span>
        <span><i class="lg lg--approval"></i>awaiting approval</span>
      </div>
    </div>

    <!-- ===== Inspectorul + consola ===== -->
    <div class="bottom">
      <div class="inspector" data-inspector data-tab="details">
        <div class="tabs" role="tablist" aria-label="Task instance">
          <button type="button" role="tab" data-tab-btn="details" aria-selected="true">Details</button>
          <button type="button" role="tab" data-tab-btn="logs" aria-selected="false">Logs</button>
          <button type="button" role="tab" data-tab-btn="xcom" aria-selected="false">XCom</button>
        </div>

        <!-- informații despre DAG (înainte de a selecta un task) -->
        <section class="ti is-shown" data-ti="__dag">
          <div class="pane" data-pane="details">
            <span class="label">DAG details</span>
            <h3>career_pipeline</h3>
            <dl class="kv">
              <div><dt>owner</dt><dd>{profile.name.toLowerCase().replace(" ", "_")}</dd></div>
              <div><dt>start_date</dt><dd>{entries[0]?.start}</dd></div>
              <div><dt>tasks</dt><dd>{tasks.length}</dd></div>
              <div><dt>tags</dt><dd>erp · integration · data</dd></div>
            </dl>
            <p class="hint">Press <strong>▶ Trigger DAG</strong> to run my career — or click any task to inspect it.</p>
          </div>
          <div class="pane" data-pane="logs"><p class="hint">No run yet. Trigger the DAG to see logs.</p></div>
          <div class="pane" data-pane="xcom"><p class="hint">Select a task to see what it pushed to XCom.</p></div>
        </section>

        {tasks.filter((t) => t.e).map((t) => {
          const e = t.e!;
          return (
            <section class="ti" data-ti={t.id} data-tags={(e.tags ?? []).map((x) => x.toLowerCase()).join("|")}>
              <div class="pane" data-pane="details">
                <div class="card-head">
                  {e.logo ? (
                    <img class="logo" src={e.logo} alt={e.logoAlt ?? e.org} width="44" height="44" loading="lazy" />
                  ) : e.monogram ? (
                    <span class="logo monogram" aria-hidden="true">{e.monogram}</span>
                  ) : null}
                  <div class="head-text">
                    <span class={`badge badge--${e.type}`}>{typeLabels[e.type]}</span>
                    <span class="period">{e.period}</span>
                  </div>
                </div>
                <h3>{e.title}</h3>
                {e.subtitle && <p class="subtitle">{e.subtitle}</p>}
                <p class="org">{e.org}</p>
                {e.slogan && <blockquote class="slogan">“{e.slogan}”</blockquote>}
                <p class="summary">{e.summary}</p>
              </div>
              <div class="pane" data-pane="logs">
                <ol class="ti-logs">
                  {(e.highlights ?? [e.summary]).map((h, k) => (
                    <li><span class="ts">[{e.start}-{String(k + 1).padStart(2, "0")}]</span> <span class="lvl">INFO</span> {h}</li>
                  ))}
                </ol>
              </div>
              <div class="pane" data-pane="xcom">
                <p class="xkey"><code>return_value</code> → tech_stack</p>
                <ul class="tags" aria-label="Technologies">
                  {(e.tags ?? []).map((x) => (
                    <li><button type="button" class="tag" data-skill={x.toLowerCase()} data-skill-label={x}>{x}</button></li>
                  ))}
                </ul>
              </div>
            </section>
          );
        })}

        <!-- deploy_to_your_team -->
        <section class="ti deploy" data-ti={DEPLOY}>
          <div class="pane" data-pane="details">
            <div class="bubbles" data-bubbles aria-hidden="true"></div>
            <div class="deploy-wait">
              <span class="label label--warn">Awaiting approval</span>
              <h3>Ready to deploy to your team?</h3>
              <p>All upstream tasks succeeded. {profile.currentRole} at {profile.currentCompany}, with ERP, integration and data engineering experience — tested in production.</p>
              <button type="button" class="btn primary approve" data-approve>✅ Approve deploy</button>
              <p class="hint small" data-deploy-locked>Run the DAG first — this task needs its upstream tasks to succeed.</p>
            </div>
            <div class="deploy-done">
              <span class="label label--ok">Deployed 🚀</span>
              <h3>You caught the big one 🐟</h3>
              <p>Let's talk about what I can build for your team.</p>
              <div class="deploy-actions">
                <a class="btn primary" href={`mailto:${profile.email}`}>✉ Email me</a>
                <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
                <a class="btn" href={profile.cv} download>⬇ Download CV</a>
              </div>
            </div>
          </div>
          <div class="pane" data-pane="logs"><p class="hint">Waiting for approval — no logs yet.</p></div>
          <div class="pane" data-pane="xcom"><p class="xkey"><code>return_value</code> → a new teammate</p></div>
        </section>
      </div>

      <div class="console-wrap">
        <div class="console-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><code>logs · career_pipeline</code></div>
        <pre class="console" data-console aria-live="polite" tabindex="0"><span class="ln dim">$ waiting for trigger…</span></pre>
      </div>
    </div>
  </div>

  <script type="application/json" data-dag-json set:html={dagData}></script>
</section>

<style>
  .pipe-sec { --ok: #16a34a; --run: #22c55e; --queue: #94a3b8; --warn: #f59e0b; --none: #cbd5e1; }
  .pipe-wrap { max-width: 1320px; margin: 1.5rem auto 0; padding: 0 clamp(1rem, 3vw, 2rem); }

  /* ---------- Fereastra DAG ---------- */
  .dag-window { border: 1px solid var(--border); border-radius: 18px; background: #fff; box-shadow: 0 20px 44px -30px rgba(15, 23, 42, 0.45); overflow: hidden; }
  .dag-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.75rem 1rem; background: #f8fafc; border-bottom: 1px solid var(--border);
  }
  .dag-title { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .dag-title code { font-weight: 700; font-size: 1rem; }
  .sched { font-size: 0.8rem; color: var(--muted); padding: 0.1rem 0.5rem; border: 1px solid var(--border); border-radius: 999px; background: #fff; }
  .run-state { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.15rem 0.6rem; border-radius: 999px; background: #e2e8f0; color: #475569; }
  :global(.run-state[data-v="running"]) { background: #dcfce7; color: #15803d; }
  :global(.run-state[data-v="success"]) { background: var(--ok); color: #fff; }
  :global(.run-state[data-v="approval"]) { background: #fef3c7; color: #92400e; }
  .dag-actions { display: flex; align-items: center; gap: 0.5rem; }
  .trigger { cursor: pointer; border: none; }
  .trigger:disabled { opacity: 0.6; cursor: progress; transform: none; }
  :global(.pipe-sec[data-idle]) .trigger { animation: beckon 2s ease-in-out infinite; }
  @keyframes beckon { 0%, 100% { transform: none; } 50% { transform: translateY(-2px) scale(1.03); } }
  .text-btn { background: none; border: none; cursor: pointer; color: var(--accent); font-size: 0.88rem; padding: 0.25rem 0.4rem; }
  .text-btn:hover { text-decoration: underline; }
  .text-btn[hidden] { display: none; }

  .skill-status {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem;
    margin: 0.75rem 1rem 0; background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 0.5rem 0.9rem;
  }
  .skill-status[hidden] { display: none; }

  /* ---------- Graful ---------- */
  /* mobil/tabletă: de sus în jos (task-urile paralele stau unul lângă altul) */
  .dag {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 2.25rem;
    padding: 2rem 1rem;
    background-color: #fff;
    background-image: radial-gradient(#e2e8f0 1.2px, transparent 1.3px); background-size: 22px 22px;
  }
  .level { position: relative; z-index: 1; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  /* desktop: de la stânga la dreapta */
  @media (min-width: 1200px) {
    .dag { flex-direction: row; justify-content: space-between; gap: 1.75rem; padding: 2.5rem 1.5rem; }
    .level { flex-direction: column; flex-wrap: nowrap; }
    .task { width: 10.75rem; }
  }

  .edges { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 0; }
  .edge { fill: none; stroke: #cbd5e1; stroke-width: 2; transition: stroke 0.4s; }
  :global(.edge.ok) { stroke: var(--ok); }
  .arrow { fill: #94a3b8; }
  .packet {
    position: absolute; left: 0; top: 0; z-index: 0; width: 8px; height: 8px; border-radius: 50%;
    background: var(--run); offset-rotate: 0deg; offset-anchor: center; opacity: 0; pointer-events: none;
  }
  :global(.packet.flow) { animation: travel 0.9s linear infinite; }
  @keyframes travel { 0% { offset-distance: 0%; opacity: 0; } 15%, 85% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }

  .task {
    position: relative; display: flex; align-items: center; gap: 0.6rem; text-align: left;
    width: 13.5rem; padding: 0.65rem 0.75rem 0.65rem 0.65rem; cursor: pointer;
    background: #fff; border: 1.5px solid var(--border); border-left: 6px solid var(--none); border-radius: 10px;
    box-shadow: 0 8px 18px -14px rgba(15, 23, 42, 0.45);
    transition: border-color 0.3s, background 0.3s, transform 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .level { width: 100%; flex-wrap: nowrap; gap: 0.6rem; }
    .task { flex: 1 1 0; width: auto; min-width: 0; max-width: 20rem; padding: 0.6rem; gap: 0.45rem; }
    .t-meta { font-size: 0.7rem; }
  }
  .task:hover { transform: translateY(-2px); box-shadow: 0 14px 24px -14px rgba(15, 23, 42, 0.5); }
  .task.is-selected { outline: 2.5px solid var(--accent); outline-offset: 2px; }
  .t-body { display: flex; flex-direction: column; min-width: 0; }
  .t-id { font-size: 0.78rem; font-weight: 700; overflow-wrap: anywhere; line-height: 1.3; }
  .t-meta { font-size: 0.75rem; color: var(--muted); }
  .t-icon {
    flex-shrink: 0; width: 1.35rem; height: 1.35rem; border-radius: 50%;
    display: grid; place-items: center; font-size: 0.75rem; font-weight: 800; color: #fff;
    background: var(--none);
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .task[data-state="queued"] { border-left-color: var(--queue); border-style: dashed; border-left-style: solid; }
  .task[data-state="queued"] .t-icon { background: var(--queue); }
  .task[data-state="queued"] .t-icon::after { content: "…"; }
  .task[data-state="running"] { border-left-color: var(--run); background: #f0fdf4; }
  .task[data-state="running"] .t-icon { background: transparent; border: 2.5px solid #bbf7d0; border-top-color: var(--ok); animation: spin 0.8s linear infinite; }
  .task[data-state="running"]::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 40%;
    background: var(--run); animation: progress 1s ease-in-out infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes progress { from { transform: translateX(-100%); } to { transform: translateX(260%); } }
  .task[data-state="success"] { border-left-color: var(--ok); }
  .task[data-state="success"] .t-icon { background: var(--ok); }
  .task[data-state="success"] .t-icon::after { content: "✓"; }
  :global(.task.just-done) { animation: done-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes done-pop { 50% { transform: scale(1.05); } }
  .task[data-state="approval"] { border-left-color: var(--warn); background: #fffbeb; animation: wait 1.6s ease-in-out infinite; }
  .task[data-state="approval"] .t-icon { background: var(--warn); }
  .task[data-state="approval"] .t-icon::after { content: "!"; }
  @keyframes wait { 0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.45); } 50% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); } }
  .task--deploy { border-style: dashed; border-left-style: solid; }
  .task--deploy[data-state="success"] { background: #f0fdf4; border-style: solid; }
  :global(.task.is-match) { outline: 2.5px solid var(--accent); outline-offset: 2px; }
  :global(.task.is-dim) { opacity: 0.4; }

  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; padding: 0.6rem 1rem; border-top: 1px solid var(--border); background: #f8fafc; font-size: 0.75rem; color: var(--muted); }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .lg { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .lg--none { background: var(--none); } .lg--queued { background: var(--queue); } .lg--running { background: var(--run); }
  .lg--success { background: var(--ok); } .lg--approval { background: var(--warn); }

  /* ---------- Inspector + consolă ---------- */
  .bottom { display: grid; gap: 1rem; margin-top: 1rem; }
  @media (min-width: 1000px) { .bottom { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; } }

  .inspector { border: 1px solid var(--border); border-radius: 16px; background: #fff; overflow: hidden; box-shadow: 0 14px 32px -26px rgba(15, 23, 42, 0.4); }
  .tabs { display: flex; gap: 0.25rem; padding: 0.5rem 0.5rem 0; background: #f8fafc; border-bottom: 1px solid var(--border); }
  .tabs button {
    background: none; border: none; border-bottom: 2.5px solid transparent; padding: 0.45rem 0.8rem; cursor: pointer;
    font-size: 0.88rem; font-weight: 600; color: var(--muted);
  }
  .tabs button[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); }
  .ti { display: none; position: relative; padding: 0; border: 0; }
  :global(.ti.is-shown) { display: block; animation: ti-in 0.35s ease; }
  @keyframes ti-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .pane { padding: 1.1rem 1.25rem 1.25rem; }
  .inspector[data-tab="details"] .pane:not([data-pane="details"]),
  .inspector[data-tab="logs"] .pane:not([data-pane="logs"]),
  .inspector[data-tab="xcom"] .pane:not([data-pane="xcom"]) { display: none; }

  .label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .label--warn { color: #b45309; } .label--ok { color: var(--ok); }
  .ti h3 { margin: 0.6rem 0 0; font-size: 1.2rem; line-height: 1.3; }
  .kv { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin: 0.9rem 0; }
  .kv div { background: #f8fafc; border-radius: 8px; padding: 0.45rem 0.65rem; }
  .kv dt { font: 600 0.72rem ui-monospace, Menlo, monospace; color: var(--muted); }
  .kv dd { margin: 0; font-weight: 600; font-size: 0.9rem; }
  .hint { color: var(--muted); margin: 0; }
  .hint.small { font-size: 0.85rem; margin-top: 0.75rem; }
  .card-head { display: flex; gap: 0.75rem; align-items: center; }
  .head-text { display: flex; flex: 1; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; }
  .logo { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
  .monogram { display: grid; place-items: center; font-weight: 800; font-size: 0.85rem; color: #fff; background: linear-gradient(135deg, #2563eb, #d97706); }
  .badge { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.55rem; border-radius: 999px; }
  .badge--work { color: #2563eb; background: #dbeafe; }
  .badge--certification { color: #b45309; background: #fef3c7; }
  .badge--education { color: #047857; background: #d1fae5; }
  .period { color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .subtitle { margin: 0.15rem 0 0; font-weight: 600; color: #7c3aed; font-size: 0.92rem; }
  .org { margin: 0.15rem 0 0.5rem; color: var(--muted); font-weight: 500; }
  .slogan { margin: 0.6rem 0 0.75rem; padding-left: 0.8rem; border-left: 3px solid var(--accent); font-style: italic; font-weight: 600; }
  .summary { margin: 0; }
  .ti-logs { list-style: none; margin: 0; padding: 0; font: 0.84rem/1.55 ui-monospace, Menlo, monospace; }
  .ti-logs li { padding: 0.3rem 0; border-bottom: 1px dashed var(--border); }
  .ts { color: var(--muted); } .lvl { color: var(--ok); font-weight: 700; }
  .xkey { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.6rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }
  .tag { font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 6px; cursor: pointer; background: var(--surface); border: 1px solid var(--border); font-family: ui-monospace, Menlo, monospace; }
  .tag:hover { border-color: var(--accent); }
  :global(.tag.is-active) { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* deploy */
  .deploy .pane[data-pane="details"] { overflow: hidden; }
  .deploy p { margin: 0.5rem 0 0; }
  .approve { margin-top: 1rem; cursor: pointer; border: none; }
  .approve:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
  .deploy-done { display: none; }
  :global(.deploy.is-deployed) .deploy-wait { display: none; }
  :global(.deploy.is-deployed) .deploy-done { display: block; animation: ti-in 0.5s ease; }
  .deploy-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; position: relative; z-index: 1; }
  .bubbles { position: absolute; inset: 0; pointer-events: none; }
  :global(.bubbles i) { position: absolute; bottom: -12px; border-radius: 50%; opacity: 0; background: var(--c); animation: confetti 1.8s cubic-bezier(0.2, 0.6, 0.4, 1) forwards; }
  @keyframes confetti { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(var(--dx), -260px) rotate(var(--r)); } }

  .console-wrap { border-radius: 16px; overflow: hidden; background: #0f172a; box-shadow: 0 14px 32px -24px rgba(15, 23, 42, 0.6); }
  .console-bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.85rem; background: #1e293b; color: #94a3b8; font-size: 0.78rem; }
  .dots { display: inline-flex; gap: 4px; }
  .dots i { width: 9px; height: 9px; border-radius: 50%; background: #475569; }
  .dots i:first-child { background: #f87171; } .dots i:nth-child(2) { background: #fbbf24; } .dots i:nth-child(3) { background: #34d399; }
  .console {
    margin: 0; padding: 0.85rem 1rem; height: 18rem; overflow-y: auto; overscroll-behavior: contain;
    font: 0.78rem/1.6 ui-monospace, Menlo, monospace; color: #e2e8f0; white-space: pre-wrap; word-break: break-word;
  }
  :global(.console .ln) { display: block; animation: ln-in 0.25s ease; }
  @keyframes ln-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
  :global(.console .t) { color: #64748b; }
  :global(.console .i) { color: #4ade80; font-weight: 700; }
  :global(.console .w) { color: #fbbf24; font-weight: 700; }
  :global(.console .id) { color: #93c5fd; }
  :global(.console .dim) { color: #64748b; }

  @media (prefers-reduced-motion: reduce) {
    .task, .packet, .trigger { animation: none !important; }
    :global(.ti.is-shown), :global(.console .ln) { animation: none; }
  }
</style>

<script>
  type T = { id: string; after: string[]; logs: string[]; year: string };
  const sec = document.querySelector<HTMLElement>("[data-pipe]");
  if (sec) {
    const data: T[] = JSON.parse(sec.querySelector("[data-dag-json]")!.textContent!);
    const DEPLOY = "deploy_to_your_team";
    const dag = sec.querySelector<HTMLElement>("[data-dag]")!;
    const svg = sec.querySelector<SVGSVGElement>("[data-edges]")!;
    const nodeEl = (id: string) => dag.querySelector<HTMLButtonElement>(`[data-task="${id}"]`)!;
    const inspector = sec.querySelector<HTMLElement>("[data-inspector]")!;
    const consoleEl = sec.querySelector<HTMLElement>("[data-console]")!;
    const runState = sec.querySelector<HTMLElement>("[data-run-state]")!;
    const triggerBtn = sec.querySelector<HTMLButtonElement>("[data-trigger]")!;
    const showAllBtn = sec.querySelector<HTMLButtonElement>("[data-show-all]")!;
    const resetBtn = sec.querySelector<HTMLButtonElement>("[data-reset]")!;
    const approveBtn = sec.querySelector<HTMLButtonElement>("[data-approve]")!;
    const deployLocked = sec.querySelector<HTMLElement>("[data-deploy-locked]")!;
    const status = sec.querySelector<HTMLElement>("[data-skill-status]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

    let running = false;
    let follow = true;          // inspectorul urmărește task-ul care rulează, până când alegi tu unul
    let runId = 0;              // anulează o rulare veche la Reset
    let activeSkill: string | null = null;
    sec.toggleAttribute("data-idle", true);

    // ---------- Liniile dintre task-uri ----------
    function rel(el: HTMLElement) {
      const r = el.getBoundingClientRect(), d = dag.getBoundingClientRect();
      return { left: r.left - d.left, right: r.right - d.left, top: r.top - d.top, bottom: r.bottom - d.top, cx: r.left - d.left + r.width / 2, cy: r.top - d.top + r.height / 2 };
    }
    function elbow(pts: [number, number][], r = 10) {
      let d = `M${pts[0][0]} ${pts[0][1]}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const [px, py] = pts[i - 1], [x, y] = pts[i], [nx, ny] = pts[i + 1];
        const r1 = Math.min(r, Math.hypot(x - px, y - py) / 2, Math.hypot(nx - x, ny - y) / 2);
        d += ` L${x - Math.sign(x - px) * r1} ${y - Math.sign(y - py) * r1} Q${x} ${y} ${x + Math.sign(nx - x) * r1} ${y + Math.sign(ny - y) * r1}`;
      }
      const l = pts[pts.length - 1];
      return d + ` L${l[0]} ${l[1]}`;
    }
    function layout() {
      svg.setAttribute("viewBox", `0 0 ${dag.clientWidth} ${dag.clientHeight}`);
      svg.querySelectorAll<SVGPathElement>(".edge").forEach((p) => {
        const a = rel(nodeEl(p.dataset.from!)), b = rel(nodeEl(p.dataset.to!));
        let pts: [number, number][];
        if (b.left >= a.right - 4) {
          const mx = (a.right + b.left) / 2;
          pts = [[a.right, a.cy], [mx, a.cy], [mx, b.cy], [b.left - 4, b.cy]];
        } else {
          const my = (a.bottom + b.top) / 2;
          pts = [[a.cx, a.bottom], [a.cx, my], [b.cx, my], [b.cx, b.top - 4]];
        }
        const d = elbow(pts);
        p.setAttribute("d", d);
        const pk = dag.querySelector<HTMLElement>(`[data-pfrom="${p.dataset.from}"][data-pto="${p.dataset.to}"]`);
        if (pk) pk.style.offsetPath = `path("${d}")`;
      });
    }
    layout();
    new ResizeObserver(layout).observe(dag);
    document.fonts?.ready.then(layout);

    // ---------- Stări ----------
    const SR: Record<string, string> = { none: "not started", queued: "queued", running: "running", success: "success", approval: "awaiting approval" };
    function setState(id: string, s: string) {
      const n = nodeEl(id);
      n.dataset.state = s;
      n.querySelector("[data-sr]")!.textContent = SR[s];
      if (s === "success") {
        n.classList.remove("just-done"); void n.offsetWidth; n.classList.add("just-done");
        svg.querySelectorAll(`.edge[data-from="${id}"]`).forEach((e) => e.classList.add("ok"));
      }
      dag.querySelectorAll<HTMLElement>(`[data-pto="${id}"]`).forEach((p) => p.classList.toggle("flow", s === "running" && !reduce));
      approveBtn.disabled = nodeEl(DEPLOY).dataset.state !== "approval";
      deployLocked.hidden = !approveBtn.disabled || nodeEl(DEPLOY).dataset.state === "success";
    }
    function setRun(v: string) { runState.textContent = v === "approval" ? "awaiting approval" : v; runState.dataset.v = v; }

    // ---------- Consola ----------
    function stamp() { const d = new Date(); return d.toTimeString().slice(0, 8); }
    function log(level: "INFO" | "WARN" | "dim", text: string, id?: string) {
      const ln = document.createElement("span");
      ln.className = "ln";
      if (level === "dim") { ln.classList.add("dim"); ln.textContent = text; }
      else {
        const t = document.createElement("span"); t.className = "t"; t.textContent = `[${stamp()}] `;
        const l = document.createElement("span"); l.className = level === "INFO" ? "i" : "w"; l.textContent = level.padEnd(5);
        ln.append(t, l, " ");
        if (id) { const s = document.createElement("span"); s.className = "id"; s.textContent = `${id} `; ln.append(s, "- "); }
        ln.append(text);
      }
      consoleEl.appendChild(ln);
      consoleEl.scrollTop = consoleEl.scrollHeight;   // derulează doar în consolă, nu pagina
    }

    // ---------- Inspector ----------
    function inspect(id: string, byUser = false) {
      if (byUser) follow = false;
      inspector.querySelectorAll(".ti").forEach((t) => t.classList.toggle("is-shown", (t as HTMLElement).dataset.ti === id));
      dag.querySelectorAll(".task").forEach((t) => t.classList.toggle("is-selected", (t as HTMLElement).dataset.task === id));
    }
    function setTab(tab: string) {
      inspector.dataset.tab = tab;
      inspector.querySelectorAll<HTMLButtonElement>("[data-tab-btn]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tabBtn === tab)));
    }
    inspector.querySelectorAll<HTMLButtonElement>("[data-tab-btn]").forEach((b) => b.addEventListener("click", () => setTab(b.dataset.tabBtn!)));
    dag.querySelectorAll<HTMLButtonElement>(".task").forEach((b) => b.addEventListener("click", () => {
      inspect(b.dataset.task!, true);
      if (b.dataset.task === DEPLOY) setTab("details");
      if (window.matchMedia("(max-width: 999px)").matches) inspector.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "nearest" });
    }));

    // ---------- Rularea DAG-ului ----------
    async function runTask(t: T, my: number) {
      setState(t.id, "running");
      if (follow) { inspect(t.id); setTab("details"); }
      for (const line of t.logs) {
        if (my !== runId) return;
        log("INFO", line, t.id);
        await wait(380);
      }
      if (my !== runId) return;
      setState(t.id, "success");
    }

    async function trigger() {
      if (running) return;
      if (nodeEl(DEPLOY).dataset.state !== "none") resetAll(false);
      running = true; follow = true;
      const my = ++runId;
      sec.removeAttribute("data-idle");
      triggerBtn.disabled = true; resetBtn.hidden = false;
      setRun("running");
      consoleEl.replaceChildren();
      log("dim", `$ airflow dags trigger career_pipeline`);
      log("INFO", "DagRun created — running tasks in dependency order");
      const done = new Set<string>();
      const work = data.filter((t) => t.id !== DEPLOY);
      while (done.size < work.length) {
        const ready = work.filter((t) => !done.has(t.id) && t.after.every((a) => done.has(a)));
        ready.forEach((t) => setState(t.id, "queued"));
        await wait(420);
        if (my !== runId) return;
        await Promise.all(ready.map((t) => runTask(t, my)));
        if (my !== runId) return;
        ready.forEach((t) => done.add(t.id));
      }
      setState(DEPLOY, "approval");
      setRun("approval");
      log("WARN", "is waiting for manual approval — click ✅ Approve deploy", DEPLOY);
      inspect(DEPLOY); setTab("details");
      running = false; triggerBtn.disabled = false; triggerBtn.textContent = "↻ Re-run DAG";
    }

    function showAll() {
      runId++; running = false;
      sec.removeAttribute("data-idle");
      consoleEl.replaceChildren();
      log("dim", "$ airflow tasks states-for-dag-run career_pipeline");
      data.filter((t) => t.id !== DEPLOY).forEach((t) => {
        setState(t.id, "success");
        log("INFO", t.logs[0].replace("Starting task — ", ""), t.id);
      });
      setState(DEPLOY, "approval");
      setRun("approval");
      log("WARN", "is waiting for manual approval", DEPLOY);
      triggerBtn.disabled = false; triggerBtn.textContent = "↻ Re-run DAG"; resetBtn.hidden = false;
      if (follow) { inspect(DEPLOY); setTab("details"); }
    }

    function resetAll(clearConsole = true) {
      runId++; running = false; follow = true;
      data.forEach((t) => setState(t.id, "none"));
      svg.querySelectorAll(".edge").forEach((e) => e.classList.remove("ok"));
      sec.querySelector(".deploy")!.classList.remove("is-deployed");
      setRun("idle");
      triggerBtn.disabled = false; triggerBtn.textContent = "▶ Trigger DAG";
      if (clearConsole) {
        consoleEl.replaceChildren(); log("dim", "$ waiting for trigger…");
        resetBtn.hidden = true; sec.toggleAttribute("data-idle", true);
        inspect("__dag"); setTab("details");
      }
    }

    async function approve() {
      if (nodeEl(DEPLOY).dataset.state !== "approval") return;
      setState(DEPLOY, "running");
      log("INFO", "Approved by visitor — deploying… 🚀", DEPLOY);
      await wait(900);
      setState(DEPLOY, "success");
      setRun("success");
      log("INFO", "Deployment successful. You caught the big one 🐟", DEPLOY);
      const d = sec.querySelector<HTMLElement>(".deploy")!;
      d.classList.add("is-deployed");
      inspect(DEPLOY); setTab("details");
      if (!reduce) {
        const box = d.querySelector<HTMLElement>("[data-bubbles]")!;
        box.replaceChildren();
        const colors = ["#16a34a", "#2563eb", "#f59e0b", "#7c3aed", "#0ea5e9"];
        for (let i = 0; i < 36; i++) {
          const b = document.createElement("i");
          const s = 5 + Math.random() * 7;
          b.style.left = `${Math.random() * 100}%`; b.style.width = `${s}px`; b.style.height = `${s * 1.4}px`;
          b.style.setProperty("--c", colors[i % colors.length]);
          b.style.setProperty("--dx", `${(Math.random() - 0.5) * 120}px`);
          b.style.setProperty("--r", `${Math.random() * 540}deg`);
          b.style.animationDelay = `${Math.random() * 0.4}s`;
          box.appendChild(b);
        }
      }
    }

    data.forEach((t) => setState(t.id, "none"));   // starea inițială (și butonul de aprobare blocat)
    triggerBtn.addEventListener("click", trigger);
    showAllBtn.addEventListener("click", showAll);
    resetBtn.addEventListener("click", () => resetAll());
    approveBtn.addEventListener("click", approve);

    // Butonul din partea de sus („Do you want to reel in the experience?”) pornește direct DAG-ul
    document.querySelectorAll<HTMLAnchorElement>('a[href="#journey"]').forEach((a) =>
      a.addEventListener("click", () => setTimeout(() => { if (!running && nodeEl(DEPLOY).dataset.state === "none") trigger(); }, reduce ? 0 : 700)),
    );

    // ---------- Evidențiere după tehnologie (din Skills sau din XCom) ----------
    function applySkill() {
      let n = 0;
      dag.querySelectorAll<HTMLElement>(".task").forEach((t) => {
        if (t.dataset.task === DEPLOY) return;
        const ok = !!activeSkill && (t.dataset.tags ?? "").split("|").includes(activeSkill);
        t.classList.toggle("is-match", ok);
        t.classList.toggle("is-dim", !!activeSkill && !ok);
        if (ok) n++;
      });
      document.querySelectorAll<HTMLElement>("[data-skill]").forEach((el) => {
        const on = el.dataset.skill === activeSkill;
        el.classList.toggle("is-active", on);
        el.setAttribute("aria-pressed", String(on));
      });
      if (activeSkill) {
        const label = document.querySelector<HTMLElement>(`[data-skill="${CSS.escape(activeSkill)}"]`)?.dataset.skillLabel ?? activeSkill;
        status.querySelector("[data-skill-name]")!.textContent = label;
        status.querySelector("[data-skill-count]")!.textContent = n === 1 ? "1 task" : `${n} tasks`;
        status.hidden = false;
      } else status.hidden = true;
    }
    document.addEventListener("click", (ev) => {
      const el = (ev.target as HTMLElement).closest<HTMLElement>("[data-skill]");
      if (!el) return;
      activeSkill = activeSkill === el.dataset.skill ? null : el.dataset.skill!;
      applySkill();
      if (activeSkill && !sec.contains(el)) dag.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
    });
    status.querySelector("[data-clear-skill]")!.addEventListener("click", () => { activeSkill = null; applySkill(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && activeSkill) { activeSkill = null; applySkill(); } });
  }
</script>
