---
/**
 * „Map my profile to your role” — în stilul unui editor de mapare iPaaS (Boomi).
 * Source (stânga) = experiența mea; Target (dreapta) = cerințele rolului ales de vizitator.
 * Liniile leagă fiecare cerință de rolurile unde am folosit-o (pe baza tag-urilor reale din timeline).
 */
import { timeline, typeLabels, profile, rolePresets } from "../data/cv";

const entries = [...timeline].sort((a, b) => a.start.localeCompare(b.start));
const allTags = [...new Set(entries.flatMap((e) => e.tags ?? []))].sort((a, b) => a.localeCompare(b));

const data = JSON.stringify({
  entries: entries.map((e, i) => ({ i, short: e.short ?? e.org, tags: (e.tags ?? []).map((t) => t.toLowerCase()) })),
  presets: rolePresets.map((r) => ({ key: r.key, label: r.label, reqs: r.reqs.map((q) => ({ label: q.label, tags: q.tags.map((t) => t.toLowerCase()) })) })),
});
---

<section id="journey" class="map-sec" data-mapper>
  <div class="container head">
    <p class="eyebrow">Cast my story</p>
    <h2>Map my profile to your role</h2>
    <p class="lead">Pick the role you're hiring for. The map links each requirement to the real experience behind it — no buzzwords, just evidence.</p>
  </div>

  <div class="map-wrap">
    <!-- alegerea rolului -->
    <div class="roles" role="tablist" aria-label="Role you're hiring for">
      {rolePresets.map((r, k) => (
        <button type="button" role="tab" class="role-tab" data-role={r.key} aria-selected={k === 0 ? "true" : "false"}>{r.label}</button>
      ))}
      <button type="button" role="tab" class="role-tab" data-role="custom" aria-selected="false">✎ Custom</button>
    </div>

    <!-- Custom: vizitatorul își alege tehnologiile -->
    <div class="custom" data-custom hidden>
      <p class="custom-hint">Click the technologies your role needs:</p>
      <div class="chips">
        {allTags.map((t) => <button type="button" class="chip" data-chip={t.toLowerCase()} aria-pressed="false">{t}</button>)}
      </div>
    </div>

    <!-- editorul de mapare -->
    <div class="mapper">
      <div class="panel source">
        <div class="panel-head"><span class="kind">Source</span><code>profile.zahariea_cosmin</code></div>
        <ol class="rows">
          {entries.map((e, i) => (
            <li>
              <button type="button" class="row src-row" data-src={i}>
                {e.logo ? (
                  <img class="logo" src={e.logo} alt="" width="28" height="28" loading="lazy" />
                ) : (
                  <span class="logo monogram" aria-hidden="true">{e.monogram ?? e.org.slice(0, 2)}</span>
                )}
                <span class="row-text">
                  <strong>{e.short ?? e.org}</strong>
                  <span>{e.title}</span>
                </span>
                <span class="row-meta">{e.start.slice(0, 4)}</span>
                <span class="count" data-count></span>
                <span class="port port--out" aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="wires" aria-hidden="true">
        <svg data-wires></svg>
      </div>

      <div class="panel target">
        <div class="panel-head"><span class="kind kind--target">Target</span><code data-target-name>role.data_engineer</code></div>
        <ol class="rows" data-target-rows></ol>
        <p class="empty" data-empty hidden>Pick a few technologies above to build your role.</p>
      </div>
    </div>

    <!-- rezultatul -->
    <div class="result" data-result>
      <div class="score">
        <span class="score-num"><strong data-score>0</strong>%</span>
        <div class="score-text">
          <strong data-verdict>Match</strong>
          <span data-detail></span>
        </div>
      </div>
      <div class="bar" aria-hidden="true"><span class="bar-fill" data-bar></span></div>
      <div class="result-cta">
        <a class="btn primary" href={`mailto:${profile.email}`}>🎣 Looks like a catch? Let's talk</a>
        <a class="btn" href={profile.cv} download>⬇ Download CV</a>
      </div>
    </div>

    <!-- detaliile rolului selectat din Source -->
    <div class="details" data-details>
      <p class="details-hint" data-details-hint>Click any role to see what I did there.</p>
      {entries.map((e, i) => (
        <article class="card" data-card={i} hidden>
          <div class="card-head">
            {e.logo ? (
              <img class="logo lg" src={e.logo} alt={e.logoAlt ?? e.org} width="44" height="44" loading="lazy" />
            ) : (
              <span class="logo lg monogram" aria-hidden="true">{e.monogram ?? e.org.slice(0, 2)}</span>
            )}
            <div class="head-text">
              <span class={`badge badge--${e.type}`}>{typeLabels[e.type]}</span>
              <span class="period">{e.period}</span>
            </div>
          </div>
          <h3>{e.title}</h3>
          {e.subtitle && <p class="subtitle">{e.subtitle}</p>}
          <p class="org">{e.org}</p>
          {e.slogan && <blockquote class="slogan">“{e.slogan}”</blockquote>}
          <p class="summary">{e.summary}</p>
          {e.tags && (
            <ul class="tags" aria-label="Technologies">
              {e.tags.map((t) => <li class="tag" data-tag={t.toLowerCase()}>{t}</li>)}
            </ul>
          )}
          {e.highlights && (
            <details>
              <summary>What I did <span class="n">({e.highlights.length})</span></summary>
              <ul class="highlights">{e.highlights.map((h) => <li>{h}</li>)}</ul>
            </details>
          )}
        </article>
      ))}
    </div>
  </div>

  <noscript><p class="container">Turn on JavaScript to use the interactive role map — or <a href={profile.cv}>download my CV</a>.</p></noscript>
  <script type="application/json" data-map-json set:html={data}></script>
</section>

<style>
  .map-sec { --src: #7c3aed; --tgt: #2563eb; --ok: #16a34a; --gap: #dc2626; }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .head h2 { margin: 0.3rem 0 0.5rem; }
  .map-wrap { max-width: 1180px; margin: 1.5rem auto 0; padding: 0 clamp(1rem, 3vw, 2rem); }

  /* ---- Tab-urile de rol ---- */
  .roles { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .role-tab {
    padding: 0.55rem 1rem; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 0.92rem;
    background: #fff; border: 1.5px solid var(--border); color: var(--text); transition: all 0.2s;
  }
  .role-tab:hover { border-color: var(--tgt); }
  .role-tab[aria-selected="true"] { background: var(--tgt); border-color: var(--tgt); color: #fff; box-shadow: 0 10px 22px -12px rgba(37, 99, 235, 0.7); }

  .custom { margin-top: 0.9rem; padding: 0.9rem 1rem; border: 1px dashed #93c5fd; border-radius: 14px; background: #f8fbff; }
  .custom[hidden] { display: none; }
  .custom-hint { margin: 0 0 0.6rem; font-size: 0.88rem; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { font-size: 0.8rem; padding: 0.25rem 0.65rem; border-radius: 999px; cursor: pointer; background: #fff; border: 1px solid var(--border); }
  .chip[aria-pressed="true"] { background: var(--tgt); border-color: var(--tgt); color: #fff; }

  /* ---- Editorul de mapare ---- */
  .mapper {
    position: relative; margin-top: 1.25rem; display: grid; gap: 0;
    grid-template-columns: minmax(0, 1fr) 160px minmax(0, 1fr);
    padding: 1.25rem; border: 1px solid var(--border); border-radius: 18px;
    background-color: #fff; background-image: radial-gradient(#e2e8f0 1.2px, transparent 1.3px); background-size: 22px 22px;
    box-shadow: 0 20px 44px -32px rgba(15, 23, 42, 0.45);
  }
  .panel { position: relative; z-index: 1; background: #fff; border: 1px solid var(--border); border-radius: 14px; overflow: visible; }
  .panel-head { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--border); background: #f8fafc; border-radius: 14px 14px 0 0; }
  .panel-head code { font-size: 0.8rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .kind { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; background: var(--src); padding: 0.12rem 0.5rem; border-radius: 6px; }
  .kind--target { background: var(--tgt); }
  .rows { list-style: none; margin: 0; padding: 0.4rem; display: grid; gap: 0.3rem; }

  .row {
    position: relative; width: 100%; display: flex; align-items: center; gap: 0.6rem; text-align: left;
    padding: 0.5rem 0.65rem; border-radius: 10px; border: 1px solid transparent; background: transparent;
    font-size: 0.9rem; transition: background 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .src-row { cursor: pointer; }
  .src-row:hover, :global(.row.is-hot) { background: #f5f3ff; border-color: #ddd6fe; }
  .target :global(.row:hover), .target :global(.row.is-hot) { background: #eff6ff; border-color: #bfdbfe; }
  :global(.row.is-selected) { border-color: var(--src); background: #f5f3ff; }
  :global(.row.is-dim) { opacity: 0.35; }
  .row-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .row-text strong { font-size: 0.9rem; }
  .row-text span { font-size: 0.75rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-meta { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .count { font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.45rem; border-radius: 999px; background: #ede9fe; color: #5b21b6; }
  .count:empty { display: none; }
  .logo { width: 28px; height: 28px; border-radius: 7px; object-fit: cover; flex-shrink: 0; }
  .monogram { display: grid; place-items: center; font-size: 0.65rem; font-weight: 800; color: #fff; background: linear-gradient(135deg, #2563eb, #d97706); }

  .port { position: absolute; top: 50%; width: 10px; height: 10px; border-radius: 50%; transform: translateY(-50%); background: #fff; border: 2px solid var(--src); }
  .port--out { right: -6px; }

  :global(.row.no-match) .port, :global(.src-row.unused) .port { border-color: #cbd5e1 !important; }

  /* rândurile din Target sunt generate în JS → au nevoie de stiluri globale */
  :global(.tgt-row) {
    position: relative; width: 100%; display: flex; align-items: center; gap: 0.6rem;
    padding: 0.55rem 0.7rem; border-radius: 10px; border: 1px solid transparent; font-size: 0.9rem;
    transition: background 0.2s, border-color 0.2s, opacity 0.2s;
  }
  :global(.port--in) {
    position: absolute; top: 50%; left: -6px; width: 10px; height: 10px; border-radius: 50%;
    transform: translateY(-50%); background: #fff; border: 2px solid #2563eb;
  }
  :global(.tgt-row .req) { flex: 1; min-width: 0; font-weight: 600; }
  :global(.tgt-row .evidence) { display: none; }
  :global(.tgt-row .mark) { flex-shrink: 0; width: 1.4rem; height: 1.4rem; border-radius: 50%; display: grid; place-items: center; font-size: 0.75rem; font-weight: 800; color: #fff; background: var(--ok); }
  :global(.tgt-row.no-match .mark) { background: #fee2e2; color: var(--gap); }
  :global(.tgt-row .ev-count) { font-size: 0.72rem; color: var(--muted); white-space: nowrap; }
  :global(.tgt-row) { cursor: default; animation: row-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--k) * 45ms); }
  @keyframes row-in { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }

  .wires { position: relative; }
  .wires svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .empty { margin: 0; padding: 1rem; color: var(--muted); font-size: 0.9rem; }
  .empty[hidden] { display: none; }

  /* liniile de mapare: le desenez în JS peste tot editorul */
  .mapper > :global(svg.wire-layer) { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; overflow: visible; }
  :global(.wire) { fill: none; stroke: #a5b4fc; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0.85; transition: stroke 0.2s, opacity 0.2s, stroke-width 0.2s; }
  :global(.wire.drawn) { animation: draw 0.7s cubic-bezier(0.65, 0, 0.35, 1) forwards; animation-delay: var(--d); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  :global(.wire.is-hot) { stroke: var(--tgt); stroke-width: 3; opacity: 1; }
  :global(.wire.is-dim) { opacity: 0.12; }

  /* ---- Rezultat ---- */
  .result {
    margin-top: 1rem; display: grid; gap: 0.75rem 1.5rem; align-items: center;
    grid-template-columns: auto 1fr; padding: 1rem 1.25rem; border-radius: 16px;
    background: linear-gradient(135deg, #eff6ff, #f0fdf4); border: 1px solid #bfdbfe;
  }
  .score { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .score-num { font-size: 2rem; font-weight: 800; color: var(--tgt); font-variant-numeric: tabular-nums; line-height: 1; }
  .score-text { display: flex; flex-direction: column; }
  .score-text span { font-size: 0.85rem; color: var(--muted); }
  .bar { grid-column: 1 / -1; height: 8px; border-radius: 999px; background: #dbeafe; overflow: hidden; }
  .bar-fill { display: block; height: 100%; width: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--tgt), var(--ok)); transform-origin: left; transform: scaleX(0); transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  .result-cta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (min-width: 900px) {
    .result { grid-template-columns: auto 1fr auto; }
    .bar { grid-column: 2; grid-row: 1; }
    .result-cta { grid-column: 3; grid-row: 1; }
  }

  /* ---- Detalii ---- */
  .details { margin-top: 1rem; }
  .details-hint { margin: 0; color: var(--muted); font-size: 0.9rem; text-align: center; }
  .details-hint[hidden] { display: none; }
  .card {
    background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--src); border-radius: 16px; padding: 1.2rem 1.35rem;
    box-shadow: 0 16px 36px -28px rgba(15, 23, 42, 0.45); animation: card-in 0.4s ease;
  }
  .card[hidden] { display: none; }
  @keyframes card-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .card-head { display: flex; gap: 0.75rem; align-items: center; }
  .head-text { display: flex; flex: 1; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; }
  .lg { width: 44px; height: 44px; border-radius: 10px; font-size: 0.85rem; }
  .badge { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.55rem; border-radius: 999px; }
  .badge--work { color: #2563eb; background: #dbeafe; }
  .badge--certification { color: #b45309; background: #fef3c7; }
  .badge--education { color: #047857; background: #d1fae5; }
  .period { color: var(--muted); font-size: 0.85rem; }
  .card h3 { margin: 0.7rem 0 0; font-size: 1.2rem; }
  .subtitle { margin: 0.15rem 0 0; font-weight: 600; color: #7c3aed; font-size: 0.92rem; }
  .org { margin: 0.15rem 0 0.5rem; color: var(--muted); font-weight: 500; }
  .slogan { margin: 0.6rem 0 0.75rem; padding-left: 0.8rem; border-left: 3px solid var(--accent); font-style: italic; font-weight: 600; }
  .summary { margin: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.9rem 0 0; }
  .tag { font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); }
  :global(.tag.is-req) { background: #dbeafe; border-color: #93c5fd; color: #1e40af; font-weight: 600; }
  details { margin-top: 0.9rem; border-top: 1px solid var(--border); padding-top: 0.6rem; }
  summary { cursor: pointer; color: var(--accent); font-weight: 500; font-size: 0.9rem; }
  summary .n { color: var(--muted); font-weight: 400; }
  .highlights { margin: 0.6rem 0 0; padding-left: 1.1rem; }
  .highlights li { margin-bottom: 0.4rem; }

  /* ---- Mobil: fără linii — fiecare cerință arată direct rolurile care o acoperă ---- */
  @media (max-width: 899px) {
    .mapper { grid-template-columns: 1fr; padding: 0.75rem; }
    .source, .wires, .mapper > :global(svg.wire-layer) { display: none; }
    :global(.tgt-row) { flex-wrap: wrap; }
    :global(.tgt-row .ev-count) { display: none; }
    :global(.tgt-row .evidence) { display: flex; flex-wrap: wrap; gap: 0.3rem; width: 100%; padding-left: 2rem; }
    :global(.ev-chip) { font-size: 0.75rem; padding: 0.15rem 0.55rem; border-radius: 999px; background: #f5f3ff; border: 1px solid #ddd6fe; color: #5b21b6; cursor: pointer; }
    :global(.port--in) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.wire.drawn) { animation: none; stroke-dashoffset: 0; }
    :global(.tgt-row), .card { animation: none; }
    .bar-fill { transition: none; }
  }
</style>

<script>
  type E = { i: number; short: string; tags: string[] };
  type Req = { label: string; tags: string[] };
  type Preset = { key: string; label: string; reqs: Req[] };

  const sec = document.querySelector<HTMLElement>("[data-mapper]");
  if (sec) {
    const { entries, presets } = JSON.parse(sec.querySelector("[data-map-json]")!.textContent!) as { entries: E[]; presets: Preset[] };
    const mapper = sec.querySelector<HTMLElement>(".mapper")!;
    const targetRows = sec.querySelector<HTMLElement>("[data-target-rows]")!;
    const targetName = sec.querySelector<HTMLElement>("[data-target-name]")!;
    const emptyEl = sec.querySelector<HTMLElement>("[data-empty]")!;
    const custom = sec.querySelector<HTMLElement>("[data-custom]")!;
    const srcRows = [...sec.querySelectorAll<HTMLButtonElement>("[data-src]")];
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>("[data-role]")];
    const chips = [...sec.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const scoreEl = sec.querySelector<HTMLElement>("[data-score]")!;
    const verdictEl = sec.querySelector<HTMLElement>("[data-verdict]")!;
    const detailEl = sec.querySelector<HTMLElement>("[data-detail]")!;
    const bar = sec.querySelector<HTMLElement>("[data-bar]")!;
    const cards = [...sec.querySelectorAll<HTMLElement>("[data-card]")];
    const detailsHint = sec.querySelector<HTMLElement>("[data-details-hint]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // stratul cu liniile, peste tot editorul
    const NS = "http://www.w3.org/2000/svg";
    const layer = document.createElementNS(NS, "svg");
    layer.classList.add("wire-layer");
    layer.setAttribute("aria-hidden", "true");
    mapper.appendChild(layer);

    let reqs: Req[] = presets[0].reqs;
    let roleLabel = presets[0].label;
    let customTags: string[] = [];
    let selected: number | null = null;

    const evidence = (q: Req) => entries.filter((e) => e.tags.some((t) => q.tags.includes(t)));

    function renderTargets(animate = true) {
      targetRows.replaceChildren();
      reqs.forEach((q, k) => {
        const ev = evidence(q);
        const li = document.createElement("li");
        const row = document.createElement("div");
        row.className = "row tgt-row" + (ev.length ? "" : " no-match");
        row.dataset.req = String(k);
        row.style.setProperty("--k", String(animate ? k : 0));
        row.tabIndex = 0;

        const mark = document.createElement("span"); mark.className = "mark"; mark.textContent = ev.length ? "✓" : "–";
        const label = document.createElement("span"); label.className = "req"; label.textContent = q.label;
        const cnt = document.createElement("span"); cnt.className = "ev-count";
        cnt.textContent = ev.length ? `${ev.length} source${ev.length > 1 ? "s" : ""}` : "not yet";
        const evBox = document.createElement("span"); evBox.className = "evidence";
        ev.forEach((e) => {
          const c = document.createElement("button");
          c.type = "button"; c.className = "ev-chip"; c.textContent = e.short;
          c.addEventListener("click", () => select(e.i, true));
          evBox.appendChild(c);
        });
        const port = document.createElement("span"); port.className = "port port--in";
        row.append(mark, label, cnt, evBox, port);
        row.addEventListener("mouseenter", () => hotReq(k));
        row.addEventListener("mouseleave", clearHot);
        row.addEventListener("focus", () => hotReq(k));
        row.addEventListener("blur", clearHot);
        li.appendChild(row);
        targetRows.appendChild(li);
      });
      emptyEl.hidden = reqs.length > 0;

      // câte cerințe acoperă fiecare rol din Source
      srcRows.forEach((r) => {
        const e = entries[Number(r.dataset.src)];
        const n = reqs.filter((q) => e.tags.some((t) => q.tags.includes(t))).length;
        r.querySelector<HTMLElement>("[data-count]")!.textContent = n ? `${n} ✓` : "";
        r.classList.toggle("unused", n === 0);
      });

      updateScore();
      requestAnimationFrame(() => drawWires(animate));
      markCardTags();
    }

    // ---- Liniile ----
    function drawWires(animate: boolean) {
      layer.replaceChildren();
      if (window.matchMedia("(max-width: 899px)").matches) return;
      const m = mapper.getBoundingClientRect();
      layer.setAttribute("viewBox", `0 0 ${m.width} ${m.height}`);
      let n = 0;
      reqs.forEach((q, k) => {
        const tRow = targetRows.querySelector<HTMLElement>(`[data-req="${k}"]`);
        if (!tRow) return;
        const tr = tRow.getBoundingClientRect();
        evidence(q).forEach((e) => {
          const sRow = srcRows[e.i].getBoundingClientRect();
          const x1 = sRow.right - m.left, y1 = sRow.top + sRow.height / 2 - m.top;
          const x2 = tr.left - m.left, y2 = tr.top + tr.height / 2 - m.top;
          const dx = (x2 - x1) * 0.5;
          const p = document.createElementNS(NS, "path");
          p.setAttribute("d", `M${x1} ${y1} C${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`);
          p.setAttribute("pathLength", "1");
          p.classList.add("wire");
          p.dataset.req = String(k);
          p.dataset.src = String(e.i);
          if (animate && !reduce) { p.style.setProperty("--d", `${120 + n * 35}ms`); p.classList.add("drawn"); }
          else p.style.strokeDashoffset = "0";
          layer.appendChild(p);
          n++;
        });
      });
    }

    function hotReq(k: number) {
      const ids = new Set(evidence(reqs[k]).map((e) => e.i));
      layer.querySelectorAll<SVGPathElement>(".wire").forEach((w) => {
        const on = w.dataset.req === String(k);
        w.classList.toggle("is-hot", on); w.classList.toggle("is-dim", !on);
      });
      srcRows.forEach((r) => { const on = ids.has(Number(r.dataset.src)); r.classList.toggle("is-hot", on); r.classList.toggle("is-dim", !on); });
      targetRows.querySelectorAll<HTMLElement>(".tgt-row").forEach((r) => r.classList.toggle("is-hot", r.dataset.req === String(k)));
    }
    function hotSrc(i: number) {
      const e = entries[i];
      const ks = new Set(reqs.map((q, k) => (e.tags.some((t) => q.tags.includes(t)) ? k : -1)).filter((k) => k >= 0));
      layer.querySelectorAll<SVGPathElement>(".wire").forEach((w) => {
        const on = w.dataset.src === String(i);
        w.classList.toggle("is-hot", on); w.classList.toggle("is-dim", !on);
      });
      targetRows.querySelectorAll<HTMLElement>(".tgt-row").forEach((r) => {
        const on = ks.has(Number(r.dataset.req)); r.classList.toggle("is-hot", on); r.classList.toggle("is-dim", !on);
      });
      srcRows.forEach((r) => r.classList.toggle("is-hot", Number(r.dataset.src) === i));
    }
    function clearHot() {
      sec!.querySelectorAll(".is-hot, .is-dim").forEach((el) => el.classList.remove("is-hot", "is-dim"));
    }

    // ---- Scorul ----
    function updateScore() {
      const total = reqs.length;
      const ok = reqs.filter((q) => evidence(q).length > 0).length;
      const pct = total ? Math.round((ok / total) * 100) : 0;
      animateNumber(scoreEl, pct);
      bar.style.transform = `scaleX(${pct / 100})`;
      verdictEl.textContent = !total ? "Build your role" : pct === 100 ? `Strong fit for ${roleLabel}` : pct >= 70 ? `Good fit for ${roleLabel}` : `Partial fit for ${roleLabel}`;
      detailEl.textContent = total ? `${ok} of ${total} requirements backed by real experience${ok < total ? " — the rest I'd learn fast" : ""}.` : "Pick technologies above.";
    }
    function animateNumber(el: HTMLElement, to: number) {
      const from = Number(el.textContent) || 0;
      if (reduce) { el.textContent = String(to); return; }
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / 700);
        el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // ---- Detalii ----
    function select(i: number, scroll = false) {
      selected = i;
      srcRows.forEach((r) => r.classList.toggle("is-selected", Number(r.dataset.src) === i));
      cards.forEach((c) => (c.hidden = Number(c.dataset.card) !== i));
      detailsHint.hidden = true;
      markCardTags();
      if (scroll) cards[i].scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "nearest" });
    }
    function markCardTags() {
      const wanted = new Set(reqs.flatMap((q) => q.tags));
      sec!.querySelectorAll<HTMLElement>(".card .tag").forEach((t) => t.classList.toggle("is-req", wanted.has(t.dataset.tag!)));
    }
    srcRows.forEach((r) => {
      const i = Number(r.dataset.src);
      r.addEventListener("click", () => select(i, true));
      r.addEventListener("mouseenter", () => hotSrc(i));
      r.addEventListener("mouseleave", clearHot);
    });

    // ---- Alegerea rolului ----
    function setRole(key: string) {
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.role === key)));
      custom.hidden = key !== "custom";
      if (key === "custom") {
        roleLabel = "your role";
        reqs = customTags.map((t) => ({ label: chips.find((c) => c.dataset.chip === t)?.textContent ?? t, tags: [t] }));
        targetName.textContent = "role.custom";
      } else {
        const p = presets.find((x) => x.key === key)!;
        roleLabel = p.label;
        reqs = p.reqs;
        targetName.textContent = `role.${p.label.toLowerCase().replace(/[^a-z]+/g, "_")}`;
      }
      renderTargets(true);
    }
    tabs.forEach((t) => t.addEventListener("click", () => setRole(t.dataset.role!)));
    chips.forEach((c) => c.addEventListener("click", () => {
      const t = c.dataset.chip!;
      customTags = customTags.includes(t) ? customTags.filter((x) => x !== t) : [...customTags, t];
      c.setAttribute("aria-pressed", String(customTags.includes(t)));
      setRole("custom");
    }));

    // Click pe o tehnologie din „Top skills” → rol Custom cu acea tehnologie
    document.addEventListener("click", (ev) => {
      const el = (ev.target as HTMLElement).closest<HTMLElement>("[data-skill]");
      if (!el || sec.contains(el)) return;
      const t = el.dataset.skill!;
      if (!customTags.includes(t)) customTags = [...customTags, t];
      chips.forEach((c) => c.setAttribute("aria-pressed", String(customTags.includes(c.dataset.chip!))));
      setRole("custom");
      sec.scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
    });

    // liniile se desenează abia când editorul intră pe ecran
    let shown = false;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !shown) { shown = true; renderTargets(true); }
    }, { threshold: 0.25 }).observe(mapper);
    renderTargets(false);
    layer.replaceChildren();
    new ResizeObserver(() => drawWires(false)).observe(mapper);
  }
</script>
