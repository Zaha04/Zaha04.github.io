---
/**
 * „Cast my story” ca o hartă a unui lac văzut de sus.
 * Fiecare job / certificare = un loc de pescuit (geamandură). Barca navighează de la stânga
 * (pontonul de start) la dreapta (malul „Today”, unde e peștele cel mare).
 * Pe mobil lacul se derulează orizontal și urmărește barca.
 */
import { timeline, typeLabels, profile } from "../data/cv";

const entries = [...timeline].sort((a, b) => a.start.localeCompare(b.start));
const N = entries.length;

// ---- Geometria hărții (unități SVG) ----
const W = 1200;
const H = 420;
// noduri: -1 = ponton, 0..N-1 = locuri de pescuit, N = malul final
const nodes: { x: number; y: number }[] = [];
for (let i = -1; i <= N; i++) {
  const t = (i + 1) / (N + 1);
  const x = Math.round(80 + t * (W - 160));
  let y: number;
  if (i === -1) y = 300;
  else if (i === N) y = 130;
  else y = i % 2 === 0 ? 150 : 290;
  nodes.push({ x, y });
}
const node = (i: number) => nodes[i + 1];
// segmentul j leagă nodul j-1 de nodul j (j = 0..N)
const segs = Array.from({ length: N + 1 }, (_, j) => {
  const a = node(j - 1), b = node(j);
  const dx = b.x - a.x;
  return `M${a.x} ${a.y} C${a.x + dx * 0.5} ${a.y}, ${b.x - dx * 0.5} ${b.y}, ${b.x} ${b.y}`;
});

// conturul lacului (formă organică)
const lakePath = `M60 40 C 260 5, 420 40, 600 22 S 980 10, 1150 45 C 1195 140, 1185 300, 1150 385 C 960 418, 760 395, 600 405 S 230 420, 55 385 C 15 290, 20 120, 60 40 Z`;

const lilies = [
  { x: 170, y: 70, r: 16 }, { x: 205, y: 88, r: 10 }, { x: 470, y: 375, r: 14 },
  { x: 760, y: 55, r: 15 }, { x: 1000, y: 365, r: 13 }, { x: 640, y: 225, r: 9 },
];
const reeds = [
  { x: 48, y: 70 }, { x: 62, y: 60 }, { x: 40, y: 340 }, { x: 1158, y: 360 }, { x: 1168, y: 340 }, { x: 1150, y: 60 },
];
const shadows = [
  { y: 95, d: 28, delay: 4, s: 1 }, { y: 225, d: 36, delay: 15, s: 0.8 }, { y: 360, d: 31, delay: 9, s: 1.1 },
];
const fishPath = "M-14 0 Q-4 -9 10 0 Q-4 9 -14 0 Z M10 0 L18 -6 L16 0 L18 6 Z";
---

<section id="journey" class="lake-sec" data-lake-sec>
  <div class="container head">
    <h2>Cast my story</h2>
    <p class="lead">Sail across the lake, one fishing spot at a time — from IFS ERP technical consulting to data engineering. The big one waits on the far shore.</p>
  </div>

  <!-- ===== Harta ===== -->
  <div class="lake-wrap" data-lake-wrap>
    <svg class="lake" viewBox={`0 0 ${W} ${H}`} data-lake role="group" aria-label="Map of my career as fishing spots on a lake">
      <defs>
        <radialGradient id="water" cx="50%" cy="45%" r="70%">
          <stop offset="0" stop-color="#bfe3fb" />
          <stop offset="1" stop-color="#7cc4f0" />
        </radialGradient>
        <clipPath id="lake-clip"><path d={lakePath} /></clipPath>
      </defs>

      <!-- mal + apă -->
      <path d={lakePath} class="shore" />
      <path d={lakePath} fill="url(#water)" />
      <g clip-path="url(#lake-clip)">
        <!-- valuri fine -->
        {Array.from({ length: 9 }, (_, i) => (
          <path class="wave" d={`M${40 + (i % 3) * 400 + (i * 37) % 120} ${60 + Math.floor(i / 3) * 120 + (i * 13) % 30} q12 -6 24 0 t24 0`} style={`animation-delay:-${i * 0.7}s`} />
        ))}
        <!-- pești care înoată pe sub apă (fug când treci cu mouse-ul) -->
        {shadows.map((f, i) => (
          <g class="shadow-lane" style={`--y:${f.y}px;animation-duration:${f.d}s;animation-delay:-${f.delay}s`}>
            <g class="shadow" data-shadow style={`--s:${f.s}`}>
              <path d={fishPath} transform={`scale(${f.s * 1.3})`} />
            </g>
          </g>
        ))}
      </g>

      <!-- nuferi și stuf -->
      {lilies.map((l) => (
        <g class="lily" transform={`translate(${l.x} ${l.y})`}>
          <path d={`M0 0 L${l.r} ${-l.r * 0.25} A${l.r} ${l.r} 0 1 1 ${l.r * 0.9} ${l.r * 0.35} Z`} />
        </g>
      ))}
      {reeds.map((r) => (
        <g class="reed" transform={`translate(${r.x} ${r.y})`}>
          <path d="M0 0 Q-3 -18 -2 -30 M4 0 Q6 -14 9 -24 M-4 0 Q-9 -12 -12 -20" />
          <ellipse cx="-2" cy="-31" rx="2.4" ry="6" />
        </g>
      ))}

      <!-- traseul: punctat (necunoscut) + dâra bărcii (parcurs) -->
      {segs.map((d, j) => (
        <g>
          <path class="route" d={d} data-route={j} />
          <path class="wake" d={d} data-wake={j} pathLength="1" />
        </g>
      ))}

      <!-- pontonul de start -->
      <g class="dock" transform={`translate(${node(-1).x} ${node(-1).y})`} data-spot="-1" tabindex="0" role="button" aria-label="Back to the dock">
        <rect x="-46" y="-10" width="40" height="20" rx="3" class="planks" />
        <path d="M-42 -10 V10 M-32 -10 V10 M-22 -10 V10 M-12 -10 V10" class="plank-lines" />
        <text class="spot-year" x="-26" y="34">Cast off · {entries[0]?.start.slice(0, 4)}</text>
      </g>

      <!-- locurile de pescuit -->
      {entries.map((e, i) => (
        <g
          class={`spot spot--${e.type}`}
          data-spot={i}
          data-tags={(e.tags ?? []).map((t) => t.toLowerCase()).join("|")}
          transform={`translate(${node(i).x} ${node(i).y})`}
          tabindex="0" role="button"
          aria-label={`${e.start.slice(0, 4)}: ${e.title}, ${e.org}`}
        >
          <circle class="spot-pulse" r="15" />
          <circle class="spot-hit" r="34" />
          <circle class="spot-ring" r="14" />
          <circle class="spot-dot" r="6" />
          <text class="spot-year" y={i % 2 === 0 ? -26 : -26}>{e.start.slice(0, 4)}</text>
          <text class="spot-label" y="36">{e.short ?? e.org}</text>
          <!-- peștele care sare și scapă -->
          <g class="splash" aria-hidden="true">
            <circle class="ripple" r="10" />
            <circle class="ripple r2" r="10" />
            <g class="jumper"><path d={fishPath} /></g>
            <text class="miss-txt" x="22" y="-14">Missed! 💨</text>
          </g>
        </g>
      ))}

      <!-- malul final: peștele cel mare -->
      <g class="spot spot--final" data-spot={N} transform={`translate(${node(N).x} ${node(N).y})`} tabindex="0" role="button" aria-label="Today — the big catch">
        <circle class="spot-pulse" r="18" />
        <circle class="spot-hit" r="36" />
        <circle class="spot-ring" r="17" />
        <text class="flag" y="6">🐟</text>
        <text class="spot-year" y="-28">Today</text>
        <g class="bigfish" aria-hidden="true">
          <circle class="ripple" r="14" />
          <g class="big-jumper"><path d={fishPath} transform="scale(2)" /></g>
        </g>
      </g>

      <!-- barca (văzută de sus), desenată cu prova spre +x -->
      <g class="boat" data-boat transform={`translate(${node(-1).x} ${node(-1).y})`} aria-hidden="true">
        <g class="boat-bob">
          <path class="hull" d="M-20 -9 Q8 -12 24 0 Q8 12 -20 9 Q-24 0 -20 -9 Z" />
          <path class="hull-in" d="M-15 -5.5 Q6 -8 17 0 Q6 8 -15 5.5 Z" />
          <rect x="-6" y="-6" width="3" height="12" class="seat" />
          <circle cx="-9" cy="0" r="5.5" class="hat" />
          <path d="M-6 2 L16 16" class="rod" />
        </g>
      </g>
    </svg>
    <p class="swipe-hint" aria-hidden="true">← swipe the lake →</p>
  </div>

  <!-- ===== Jurnalul de bord ===== -->
  <div class="container log" data-log>
    <div class="log-bar">
      <span class="hud"><span>Spot <strong data-n>0</strong> / {N}</span><span class="miss-count">🐟💨 missed ×<strong data-miss>0</strong></span></span>
      <div class="log-nav">
        <button type="button" class="btn icon" data-prev aria-label="Previous spot">←</button>
        <button type="button" class="btn primary sail" data-next>⛵ Start sailing</button>
      </div>
      <button type="button" class="text-btn" data-show-all>Show all</button>
    </div>

    <div class="skill-status" data-skill-status hidden aria-live="polite">
      <span>Highlighting <strong data-skill-name></strong> — <span data-skill-count></span></span>
      <button type="button" class="text-btn" data-clear-skill>Clear ✕</button>
    </div>

    <div class="cards" data-cards aria-live="polite">
      <article class="card intro is-current" data-card="-1">
        <span class="label">Captain's log</span>
        <h3>Ahoy! ⛵</h3>
        <p>{N} fishing spots on this lake, and one big fish waiting on the far shore. Click the glowing buoy on the map — or hit <strong>Start sailing</strong>.</p>
      </article>

      {entries.map((e, i) => (
        <article class="card entry" data-card={i} data-tags={(e.tags ?? []).map((t) => t.toLowerCase()).join("|")}>
          <p class="miss-note" aria-hidden="true">🐟💨 Missed the fish at this spot — sailing on…</p>
          <div class="card-head">
            {e.logo ? (
              <img class="logo" src={e.logo} alt={e.logoAlt ?? e.org} width="44" height="44" loading="lazy" />
            ) : e.monogram ? (
              <span class="logo monogram" aria-hidden="true">{e.monogram}</span>
            ) : null}
            <div class="head-text">
              <span class={`badge badge--${e.type}`}>{typeLabels[e.type]}</span>
              <span class="period">{e.period}</span>
            </div>
          </div>
          <h3>{e.title}</h3>
          {e.subtitle && <p class="subtitle">{e.subtitle}</p>}
          <p class="org">{e.org}</p>
          {e.slogan && <blockquote class="slogan">“{e.slogan}”</blockquote>}
          <p class="summary">{e.summary}</p>
          {e.tags && (
            <ul class="tags" aria-label="Technologies">
              {e.tags.map((t) => (
                <li><button type="button" class="tag" data-skill={t.toLowerCase()} data-skill-label={t}>{t}</button></li>
              ))}
            </ul>
          )}
          {e.highlights && (
            <details>
              <summary>What I did <span class="n">({e.highlights.length})</span></summary>
              <ul class="highlights">{e.highlights.map((h) => <li>{h}</li>)}</ul>
            </details>
          )}
        </article>
      ))}

      <article class="card finale" data-card={N}>
        <div class="bubbles" data-bubbles aria-hidden="true"></div>
        <span class="label">Fish on! 🎣</span>
        <h3>You sailed all the way to today.</h3>
        <p>
          {profile.currentRole} at {profile.currentCompany} — automating SAP reporting and building data tools people use every day.
          The next spot on this lake could be <strong>your team</strong>.
        </p>
        <div class="finale-actions">
          <a class="btn primary" href={`mailto:${profile.email}`}>Reel me in — let's talk</a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <button type="button" class="btn ghost" data-replay>Sail again ↺</button>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .lake-sec { --work: #2563eb; --cert: #d97706; overflow: hidden; }
  .head h2 { margin-bottom: 0.5rem; }

  /* ---------- Harta ---------- */
  .lake-wrap {
    position: relative; margin: 1.5rem auto 0; max-width: 1400px; padding: 0 clamp(0.5rem, 3vw, 2.5rem);
  }
  .lake { display: block; width: 100%; height: auto; overflow: visible; user-select: none; -webkit-user-select: none; }
  .swipe-hint { display: none; }
  /* pe ecrane mici: lacul rămâne la mărime citibilă și se derulează orizontal */
  @media (max-width: 760px) {
    .lake-wrap { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding: 0; }
    .lake-wrap::-webkit-scrollbar { display: none; }
    .lake { width: 1000px; max-width: none; }
    .swipe-hint { display: block; position: sticky; left: 0; width: 100vw; text-align: center; margin: 0.25rem 0 0; color: var(--muted); font-size: 0.8rem; }
  }

  .shore { fill: #f6e7c1; stroke: #e8d29c; stroke-width: 18; stroke-linejoin: round; }
  .wave { fill: none; stroke: rgba(255, 255, 255, 0.55); stroke-width: 2; stroke-linecap: round; animation: drift 6s ease-in-out infinite; }
  @keyframes drift { 0%, 100% { transform: translateX(0); opacity: 0.4; } 50% { transform: translateX(14px); opacity: 0.9; } }
  .lily path { fill: #4ade80; stroke: #16a34a; stroke-width: 1.5; }
  .reed path { fill: none; stroke: #65a30d; stroke-width: 2.2; stroke-linecap: round; }
  .reed ellipse { fill: #92400e; }

  .shadow-lane { animation: swim linear infinite; }
  @keyframes swim { from { transform: translate(-80px, var(--y)); } to { transform: translate(1280px, var(--y)); } }
  .shadow { fill: rgba(30, 64, 175, 0.22); transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); cursor: pointer; }
  :global(.shadow.scared) { transform: translate(40px, -36px) rotate(-30deg); }

  .route { fill: none; stroke: rgba(255, 255, 255, 0.75); stroke-width: 2.5; stroke-dasharray: 2 9; stroke-linecap: round; }
  .wake { fill: none; stroke: #fff; stroke-width: 5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0.9; }
  :global(.wake.done) { stroke-dashoffset: 0; }

  /* ponton */
  .dock { cursor: pointer; }
  .planks { fill: #a16207; stroke: #713f12; stroke-width: 1.5; }
  .plank-lines { stroke: #713f12; stroke-width: 1; }

  /* geamandurile */
  .spot { cursor: pointer; outline: none; }
  .spot-hit { fill: transparent; }
  .spot-ring { fill: #fff; stroke: #94a3b8; stroke-width: 3; transition: stroke 0.3s, fill 0.3s; }
  .spot-dot { fill: #cbd5e1; transition: fill 0.3s; }
  .spot-pulse { fill: none; stroke: #fff; stroke-width: 3; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .spot-year { font: 700 14px system-ui, sans-serif; fill: #0f3a5f; text-anchor: middle; paint-order: stroke; stroke: rgba(255, 255, 255, 0.85); stroke-width: 4px; }
  .spot-label { font: 600 13px system-ui, sans-serif; fill: #1e3a5f; text-anchor: middle; paint-order: stroke; stroke: rgba(255, 255, 255, 0.85); stroke-width: 4px; opacity: 0.55; transition: opacity 0.3s; }
  .spot:hover .spot-ring, .spot:focus-visible .spot-ring { stroke-width: 4; }
  .spot:focus-visible .spot-ring { stroke: #0f172a; }

  :global(.spot.is-next) .spot-pulse { animation: pulse 1.6s ease-out infinite; }
  :global(.spot.is-next) .spot-ring { stroke: #fff; fill: #fde68a; }
  @keyframes pulse { from { transform: scale(1); opacity: 0.9; } to { transform: scale(2.4); opacity: 0; } }
  :global(.spot.is-visited) .spot-label { opacity: 1; }
  :global(.spot--work.is-visited) .spot-ring { stroke: var(--work); }
  :global(.spot--work.is-visited) .spot-dot { fill: var(--work); }
  :global(.spot--certification.is-visited) .spot-ring { stroke: var(--cert); }
  :global(.spot--certification.is-visited) .spot-dot { fill: var(--cert); }
  :global(.spot.is-current) .spot-ring { stroke-width: 5; }
  :global(.spot.is-match) .spot-ring { fill: #2563eb; stroke: #fff; }
  :global(.spot.is-dim) { opacity: 0.35; }
  :global(.spot.nope) { animation: nope 0.4s; }
  @keyframes nope { 25% { transform: var(--t) translateX(-5px); } 75% { transform: var(--t) translateX(5px); } }

  /* peștele care sare și scapă */
  .splash { pointer-events: none; }
  .ripple { fill: none; stroke: #fff; stroke-width: 2; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .jumper path { fill: #0ea5e9; }
  .jumper { opacity: 0; }
  .miss-txt { font: 700 13px system-ui, sans-serif; fill: #b45309; opacity: 0; paint-order: stroke; stroke: #fff; stroke-width: 4px; }
  :global(.spot.missed) .ripple { animation: ripple 1.1s ease-out 0.1s; }
  :global(.spot.missed) .r2 { animation-delay: 0.45s; }
  :global(.spot.missed) .jumper { animation: jump 1s cubic-bezier(0.3, 0, 0.3, 1) both; }
  :global(.spot.missed) .miss-txt { animation: miss 2.4s ease both 0.6s; }
  @keyframes ripple { from { transform: scale(0.6); opacity: 0.9; } to { transform: scale(3); opacity: 0; } }
  @keyframes jump {
    0% { opacity: 0; transform: translate(-6px, 4px) rotate(30deg); }
    15% { opacity: 1; }
    50% { transform: translate(14px, -34px) rotate(-10deg); }
    100% { opacity: 0; transform: translate(34px, 6px) rotate(-60deg); }
  }
  @keyframes miss { 0% { opacity: 0; transform: translateY(6px); } 15%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* malul final */
  .spot--final .spot-ring { fill: #fef3c7; stroke: #f59e0b; }
  .flag { font-size: 16px; text-anchor: middle; }
  .bigfish { pointer-events: none; }
  .big-jumper { opacity: 0; }
  .big-jumper path { fill: #2563eb; stroke: #f59e0b; stroke-width: 0.8; }
  :global(.spot--final.caught) .ripple { animation: ripple 1.2s ease-out 3; }
  :global(.spot--final.caught) .big-jumper { animation: bigjump 1.4s cubic-bezier(0.3, 0, 0.3, 1) both; }
  @keyframes bigjump {
    0% { opacity: 0; transform: translate(-10px, 6px) rotate(40deg); }
    15% { opacity: 1; }
    50% { transform: translate(0, -54px) rotate(-20deg) scale(1.15); }
    80% { opacity: 1; transform: translate(-6px, -40px) rotate(-8deg); }
    100% { opacity: 1; transform: translate(-6px, -44px) rotate(0); }
  }

  /* barca */
  .boat { pointer-events: none; }
  .boat-bob { animation: bob 2.6s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
  .hull { fill: #b45309; stroke: #78350f; stroke-width: 1.5; }
  .hull-in { fill: #d97706; }
  .seat { fill: #78350f; }
  .hat { fill: #065f46; stroke: #fff; stroke-width: 1.5; }
  .rod { stroke: #713f12; stroke-width: 1.8; stroke-linecap: round; }

  /* ---------- Jurnalul de bord ---------- */
  .log { margin-top: 1.25rem; }
  .log-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.6rem 0.75rem 0.6rem 1.1rem; border-radius: 999px;
    background: #fff; border: 1px solid var(--border); box-shadow: 0 10px 30px -20px rgba(15, 23, 42, 0.4);
    position: sticky; top: calc(var(--header-h) + 0.5rem); z-index: 5;
  }
  .hud { display: flex; gap: 1rem; font-size: 0.9rem; }
  .hud strong { font-variant-numeric: tabular-nums; }
  .miss-count { color: #b45309; font-weight: 600; }
  .log-nav { display: flex; gap: 0.5rem; align-items: center; }
  .icon { padding: 0.5rem 0.85rem; cursor: pointer; background: #fff; }
  .icon:disabled { opacity: 0.35; cursor: default; transform: none; }
  .sail { cursor: pointer; border: none; }
  .sail[hidden] { display: none; }
  .text-btn { background: none; border: none; cursor: pointer; color: var(--accent); font-size: 0.88rem; padding: 0.25rem 0.5rem; }
  .text-btn:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .log-bar { border-radius: 18px; }
    .hud { width: 100%; justify-content: space-between; }
    .log-nav { flex: 1; }
    .sail { flex: 1; justify-content: center; }
  }

  .skill-status {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem;
    background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 0.6rem 1rem; margin-top: 0.75rem;
  }
  .skill-status[hidden] { display: none; }

  .cards { margin-top: 1rem; display: grid; }
  .card {
    display: none; position: relative; overflow: hidden;
    background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 1.25rem 1.4rem;
    box-shadow: 0 16px 36px -26px rgba(15, 23, 42, 0.4);
    max-width: 760px; width: 100%; margin: 0 auto;
  }
  :global(.card.is-current) { display: block; }
  :global(.card.in-next) { animation: in-next 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  :global(.card.in-prev) { animation: in-prev 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes in-next { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: none; } }
  @keyframes in-prev { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: none; } }

  /* „Show all”: toate cardurile, în grilă */
  :global(.cards.is-all) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 1rem; }
  :global(.cards.is-all .card.entry), :global(.cards.is-all .card.finale) { display: block; max-width: none; }
  :global(.cards.is-all .card.intro) { display: none; }
  :global(.cards.is-all .miss-note) { display: none; }
  :global(.card.is-dimmed) { opacity: 0.35; filter: grayscale(0.8); }
  :global(.card.is-match) { border-color: var(--accent); }
  :global(.card.flash) { animation: flash 1s; }
  @keyframes flash { 30% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 40%, transparent); } }

  .label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .intro h3 { font-size: 1.4rem; margin: 0.3rem 0 0.4rem; }
  .intro p { margin: 0; }
  .miss-note { margin: -0.25rem 0 0.75rem; font-size: 0.85rem; font-weight: 700; color: #b45309; }
  .card-head { display: flex; gap: 0.75rem; align-items: center; }
  .head-text { display: flex; flex: 1; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; }
  .logo { width: 44px; height: 44px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
  .monogram { display: grid; place-items: center; font-weight: 800; font-size: 0.85rem; color: #fff; background: linear-gradient(135deg, var(--work), var(--cert)); }
  .badge { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.15rem 0.55rem; border-radius: 999px; }
  .badge--work { color: var(--work); background: color-mix(in srgb, var(--work) 12%, transparent); }
  .badge--certification { color: #b45309; background: color-mix(in srgb, var(--cert) 14%, transparent); }
  .badge--education { color: #047857; background: #d1fae5; }
  .period { color: var(--muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .card h3 { margin: 0.75rem 0 0; font-size: 1.2rem; line-height: 1.3; }
  .subtitle { margin: 0.15rem 0 0; font-weight: 600; color: #7c3aed; font-size: 0.92rem; }
  .org { margin: 0.15rem 0 0.5rem; color: var(--muted); font-weight: 500; }
  .slogan { margin: 0.6rem 0 0.75rem; padding-left: 0.8rem; border-left: 3px solid var(--accent); font-style: italic; font-weight: 600; font-size: 1.05rem; }
  .summary { margin: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.9rem 0 0; }
  .tag { font-size: 0.8rem; padding: 0.2rem 0.6rem; border-radius: 6px; cursor: pointer; background: var(--surface); border: 1px solid var(--border); }
  .tag:hover { border-color: var(--accent); }
  :global(.tag.is-active) { background: var(--accent); border-color: var(--accent); color: #fff; }
  details { margin-top: 0.9rem; border-top: 1px solid var(--border); padding-top: 0.6rem; }
  summary { cursor: pointer; color: var(--accent); font-weight: 500; font-size: 0.9rem; }
  summary .n { color: var(--muted); font-weight: 400; }
  .highlights { margin: 0.6rem 0 0; padding-left: 1.1rem; }
  .highlights li { margin-bottom: 0.4rem; }

  .finale { background: linear-gradient(160deg, #ffffff, #e0f2fe); border-color: #bae6fd; text-align: center; }
  .finale h3 { font-size: 1.5rem; margin: 0.35rem 0 0.5rem; }
  .finale p { margin: 0; }
  .finale-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; margin-top: 1.25rem; position: relative; z-index: 1; }
  .ghost { background: transparent; cursor: pointer; }
  .bubbles { position: absolute; inset: 0; pointer-events: none; }
  :global(.bubbles i) {
    position: absolute; bottom: -14px; border-radius: 50%; opacity: 0;
    border: 1.5px solid rgba(37, 99, 235, 0.45); background: rgba(255, 255, 255, 0.7);
    animation: rise 2s cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
  }
  @keyframes rise { 0% { opacity: 0.9; transform: translate(0, 0); } 100% { opacity: 0; transform: translate(var(--dx), -280px); } }

  /* Fără JS: hartă statică + toate cardurile */
  :global(html:not(.js)) .cards { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 1rem; }
  :global(html:not(.js)) .card.entry, :global(html:not(.js)) .card.finale { display: block; }
  :global(html:not(.js)) .log-bar, :global(html:not(.js)) .miss-note { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .wave, .shadow-lane, .boat-bob { animation: none; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>("[data-lake-sec]");
  if (sec) {
    const svg = sec.querySelector<SVGSVGElement>("[data-lake]")!;
    const wrap = sec.querySelector<HTMLElement>("[data-lake-wrap]")!;
    const boat = svg.querySelector<SVGGElement>("[data-boat]")!;
    const spots = [...svg.querySelectorAll<SVGGElement>(".spot")];           // 0..N (N = malul final)
    const dock = svg.querySelector<SVGGElement>(".dock")!;
    const cardsBox = sec.querySelector<HTMLElement>("[data-cards]")!;
    const cards = [...cardsBox.querySelectorAll<HTMLElement>("[data-card]")]; // -1..N
    const card = (i: number) => cards.find((c) => c.dataset.card === String(i))!;
    const prevBtn = sec.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextBtn = sec.querySelector<HTMLButtonElement>("[data-next]")!;
    const showAllBtn = sec.querySelector<HTMLButtonElement>("[data-show-all]")!;
    const nEl = sec.querySelector<HTMLElement>("[data-n]")!;
    const missEl = sec.querySelector<HTMLElement>("[data-miss]")!;
    const status = sec.querySelector<HTMLElement>("[data-skill-status]")!;
    const N = spots.length - 1;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let cur = -1;          // unde e barca: -1 = ponton, 0..N-1 = locuri, N = malul final
    let maxVisited = -1;   // cel mai departe loc atins
    let missed = 0;
    let moving = false;
    let allMode = false;
    let activeSkill: string | null = null;

    const pos = (i: number) => {
      const g = i < 0 ? dock : spots[i];
      const m = g.transform.baseVal.consolidate()!.matrix;
      return { x: m.e, y: m.f };
    };
    spots.forEach((s, i) => s.style.setProperty("--t", `translate(${pos(i).x}px, ${pos(i).y}px)`));

    function placeBoat(x: number, y: number, angle: number) {
      boat.setAttribute("transform", `translate(${x} ${y}) rotate(${angle})`);
      follow(x);
    }
    // pe mobil, lacul se derulează ca barca să rămână pe ecran
    function follow(x: number) {
      if (wrap.scrollWidth <= wrap.clientWidth + 2) return;
      const scale = svg.getBoundingClientRect().width / 1200;
      wrap.scrollLeft = x * scale - wrap.clientWidth / 2;
    }

    // barca merge pe un segment al traseului (j leagă nodul j-1 de nodul j)
    function sailSegment(j: number, dir: 1 | -1, dur: number) {
      return new Promise<void>((resolve) => {
        const path = svg.querySelector<SVGPathElement>(`[data-route="${j}"]`)!;
        const wake = svg.querySelector<SVGPathElement>(`[data-wake="${j}"]`)!;
        const L = path.getTotalLength();
        const fresh = dir === 1 && !wake.classList.contains("done");
        const t0 = performance.now();
        const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
        function frame(now: number) {
          const t = reduce ? 1 : Math.min(1, (now - t0) / dur);
          const e = ease(t);
          const d = dir === 1 ? e * L : (1 - e) * L;
          const p = path.getPointAtLength(d);
          const q = path.getPointAtLength(Math.min(L, Math.max(0, d + dir * 2)));
          const ang = (Math.atan2(q.y - p.y, q.x - p.x) * 180) / Math.PI;
          placeBoat(p.x, p.y, ang);
          if (fresh) wake.style.strokeDashoffset = String(1 - e);
          if (t < 1) requestAnimationFrame(frame);
          else {
            if (fresh) { wake.style.strokeDashoffset = ""; wake.classList.add("done"); }
            resolve();
          }
        }
        requestAnimationFrame(frame);
      });
    }

    async function sailTo(target: number) {
      if (moving || target === cur || target < -1 || target > N) return;
      if (target > maxVisited + 1) {
        // nu sări peste locuri: întâi cel care pulsează
        const s = spots[target];
        s.classList.remove("nope"); void s.getBoundingClientRect(); s.classList.add("nope");
        return;
      }
      moving = true;
      setNavDisabled(true);
      const dir = target > cur ? 1 : -1;
      const hops = Math.abs(target - cur);
      const from = cur;
      for (let k = cur; k !== target; k += dir) {
        await sailSegment(dir === 1 ? k + 1 : k, dir as 1 | -1, hops > 1 ? 520 : 1150);
      }
      cur = target;
      const first = target > maxVisited;
      if (first) maxVisited = target;
      moving = false;
      arrive(target, first, target > from ? "in-next" : "in-prev");
    }

    function arrive(i: number, first: boolean, anim: string) {
      if (first && i >= 0 && i < N) {
        missed++;
        const s = spots[i];
        s.classList.remove("missed"); void s.getBoundingClientRect(); s.classList.add("missed");
      }
      if (first && i === N) {
        spots[N].classList.add("caught");
        burst();
      }
      showCard(i, anim);
      refresh();
    }

    function showCard(i: number, anim: string) {
      cards.forEach((c) => c.classList.remove("is-current", "in-next", "in-prev"));
      const c = card(i);
      c.classList.add("is-current");
      if (!reduce) c.classList.add(anim);
    }

    function setNavDisabled(v: boolean) {
      nextBtn.disabled = v;
      prevBtn.disabled = v || cur <= -1;
    }

    function refresh() {
      spots.forEach((s, i) => {
        s.classList.toggle("is-visited", i <= maxVisited);
        s.classList.toggle("is-current", i === cur);
        s.classList.toggle("is-next", !allMode && i === maxVisited + 1);
      });
      nEl.textContent = String(Math.max(0, Math.min(cur + 1, N)));
      missEl.textContent = String(missed);
      prevBtn.disabled = cur <= -1 || moving || allMode;
      nextBtn.hidden = allMode || cur >= N;
      nextBtn.textContent =
        cur === -1 ? "⛵ Start sailing" :
        cur === N - 1 ? "Head to shore — something's biting 🐟" :
        cur < maxVisited ? "Sail on →" : "Sail to next spot →";
      showAllBtn.textContent = allMode ? "⛵ Back to the boat" : "Show all";
    }

    function burst() {
      if (reduce) return;
      const box = card(N).querySelector<HTMLElement>("[data-bubbles]")!;
      box.replaceChildren();
      for (let i = 0; i < 30; i++) {
        const b = document.createElement("i");
        const size = 6 + Math.random() * 14;
        b.style.left = `${Math.random() * 100}%`;
        b.style.width = b.style.height = `${size}px`;
        b.style.setProperty("--dx", `${(Math.random() - 0.5) * 80}px`);
        b.style.animationDelay = `${Math.random() * 0.6}s`;
        box.appendChild(b);
      }
    }

    // ---- Show all / înapoi la barcă ----
    function setAll(on: boolean) {
      allMode = on;
      cardsBox.classList.toggle("is-all", on);
      if (on) {
        maxVisited = N;
        svg.querySelectorAll(".wake").forEach((w) => w.classList.add("done"));
        const p = pos(N);
        placeBoat(p.x - 30, p.y + 12, 0);
        cur = N;
      } else {
        showCard(cur, "in-next");
      }
      refresh();
    }

    function replay() {
      setAll(false);
      cur = -1; maxVisited = -1; missed = 0;
      svg.querySelectorAll(".wake").forEach((w) => w.classList.remove("done"));
      spots.forEach((s) => s.classList.remove("missed", "caught"));
      activeSkill = null; applySkill();
      const p = pos(-1);
      placeBoat(p.x, p.y, 0);
      showCard(-1, "in-prev");
      refresh();
    }

    // ---- Evidențiere după tehnologie (din Skills sau din carduri) ----
    function applySkill() {
      let matches = 0;
      cards.forEach((c) => {
        if (!c.classList.contains("entry")) return;
        const ok = !activeSkill || (c.dataset.tags ?? "").split("|").includes(activeSkill);
        c.classList.toggle("is-dimmed", !!activeSkill && !ok);
        c.classList.toggle("is-match", !!activeSkill && ok);
        if (activeSkill && ok) matches++;
      });
      spots.slice(0, N).forEach((s) => {
        const ok = !!activeSkill && (s.dataset.tags ?? "").split("|").includes(activeSkill);
        s.classList.toggle("is-match", ok);
        s.classList.toggle("is-dim", !!activeSkill && !ok);
      });
      document.querySelectorAll<HTMLElement>("[data-skill]").forEach((el) => {
        const on = el.dataset.skill === activeSkill;
        el.classList.toggle("is-active", on);
        el.setAttribute("aria-pressed", String(on));
      });
      if (activeSkill) {
        const label = document.querySelector<HTMLElement>(`[data-skill="${CSS.escape(activeSkill)}"]`)?.dataset.skillLabel ?? activeSkill;
        status.querySelector("[data-skill-name]")!.textContent = label;
        status.querySelector("[data-skill-count]")!.textContent = matches === 1 ? "1 spot" : `${matches} spots`;
        status.hidden = false;
      } else status.hidden = true;
    }

    document.addEventListener("click", (ev) => {
      const el = (ev.target as HTMLElement).closest<HTMLElement>("[data-skill]");
      if (!el) return;
      const key = el.dataset.skill!;
      activeSkill = activeSkill === key ? null : key;
      if (activeSkill && !allMode) setAll(true);
      applySkill();
      if (activeSkill && !sec.contains(el)) sec.scrollIntoView({ behavior: reduce ? "auto" : "smooth" });
    });
    status.querySelector("[data-clear-skill]")!.addEventListener("click", () => { activeSkill = null; applySkill(); });

    // ---- Controale ----
    nextBtn.addEventListener("click", () => sailTo(cur + 1));
    prevBtn.addEventListener("click", () => sailTo(cur - 1));
    showAllBtn.addEventListener("click", () => setAll(!allMode));
    sec.querySelector("[data-replay]")!.addEventListener("click", () => { replay(); svg.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" }); });

    const onSpot = (i: number) => {
      if (allMode) {
        const c = card(i);
        c.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
        c.classList.remove("flash"); void c.offsetWidth; c.classList.add("flash");
        return;
      }
      sailTo(i);
    };
    spots.forEach((s, i) => {
      s.addEventListener("click", () => onSpot(i));
      s.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onSpot(i); } });
    });
    dock.addEventListener("click", () => !allMode && sailTo(-1));
    dock.addEventListener("keydown", (e) => { if ((e.key === "Enter" || e.key === " ") && !allMode) { e.preventDefault(); sailTo(-1); } });

    // săgețile de la tastatură, cât timp lacul e pe ecran
    let inView = false;
    new IntersectionObserver(([e]) => (inView = e.isIntersecting), { threshold: 0.3 }).observe(svg);
    document.addEventListener("keydown", (e) => {
      if (!inView || allMode || e.altKey || e.metaKey || e.ctrlKey) return;
      if ((e.target as HTMLElement).closest("input, textarea, select")) return;
      if (e.key === "ArrowRight") { e.preventDefault(); sailTo(cur + 1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); sailTo(cur - 1); }
      if (e.key === "Escape" && activeSkill) { activeSkill = null; applySkill(); }
    });

    // peștii de sub apă fug când treci pe lângă ei
    svg.querySelectorAll<SVGGElement>("[data-shadow]").forEach((f) => {
      f.addEventListener("pointerenter", () => {
        f.classList.add("scared");
        setTimeout(() => f.classList.remove("scared"), 1300);
      });
    });

    refresh();
    follow(pos(-1).x);
  }
</script>
