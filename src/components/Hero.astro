---
import { profile } from "../data/cv";
import RoleErp from "./RoleErp.astro";
import RoleData from "./RoleData.astro";
---

<section class="stage" id="top" data-stage aria-label="Introduction">
  <div class="container stage-grid" data-flow>
    <!-- Conectorii în stil iPaaS: Poza → IFS ERP → Data Engineer → About → undița.
         Traseele se calculează în JS din pozițiile reale ale elementelor. -->
    <svg class="flow" data-flow-svg aria-hidden="true" focusable="false">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
        </marker>
      </defs>
      {[1, 2, 3, 4].map((n) => (
        <g class={`conn conn-${n}`}>
          <path id={`conn-path-${n}`} class="conn-base" d="M0 0" />
          <path class="conn-line" d="M0 0" pathLength="1" marker-end="url(#arrow)" />
        </g>
      ))}
      <g class="start-node" data-start-node>
        <circle class="start-ring" r="18" />
        <circle class="start-dot" r="16" />
        <path class="start-play" d="M-4 -6 L7 0 L-4 6 Z" />
      </g>
    </svg>
    <!-- Datele care curg pe conectori: animate cu CSS offset-path (rulează ieftin, fără SMIL) -->
    {[1, 2, 3, 4].flatMap((n) => [0, 1].map((k) => (
      <span class={`packet packet-${n}`} data-packet={n} aria-hidden="true"
        style={`animation-duration:${2.2 + n * 0.2}s;animation-delay:${1.2 + n * 0.8 + k * 1.1}s`}></span>
    )))}
    <span class="conn-label conn-label-1" data-label="1">since 2021</span>
    <span class="conn-label conn-label-2" data-label="2">since 2024</span>

    <!-- Rândul de sus: numele în stânga, motto-ul de pescar în dreapta -->
    <div class="intro">
      <div class="intro-text">
        <p class="eyebrow enter" style="--d: 120ms">Hi, I'm</p>
        <h1 class="name enter" style="--d: 200ms">{profile.name}</h1>
        <p class="tagline enter" style="--d: 320ms">
          From <span class="erp">IFS ERP consulting &amp; data integration</span> to <span class="data">data engineering</span>.
        </p>
      </div>
      <figure class="motto enter" style="--d: 520ms">
        <span class="bobber" aria-hidden="true"><span class="bobber-ripple"></span></span>
        <blockquote>Patience, the right bait and a tight line — in fishing and in data.</blockquote>
      </figure>
    </div>

    <!-- Stânga: poza + funcția actuală -->
    <div class="left">
      <div class="photo-wrap enter" style="--d: 0ms" data-node="photo">
        <img class="photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="440" height="550" />
        <div class="now enter" style="--d: 400ms">
          <span class="live" aria-hidden="true"></span>
          <div>
            <span class="label">Currently</span>
            <strong>{profile.currentRole}</strong>
            <span class="co">{profile.currentCompany}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Dreapta: nume + pașii fluxului -->
    <div class="right">
      <div class="roles">
        <div class="enter step tilt" style="--d: 1250ms" data-node="erp" data-tilt><RoleErp /></div>
        <div class="enter step tilt" style="--d: 2050ms" data-node="data" data-tilt><RoleData /></div>
      </div>

      <!-- About: următorul nod din flux, după Data Engineer -->
      <article class="about enter step" style="--d: 2750ms" data-node="about" id="about">
        <span class="about-label">About me</span>
        <p>{profile.summary}</p>
        <dl class="stats">
          {profile.stats.map((s) => (
            <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
      </article>

      <!-- Capătul fluxului: undița -->
      <a class="reel-cta enter" style="--d: 3500ms" href="#journey" data-node="cta">
        <span class="cta-rod" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="44" height="44">
            <line x1="6" y1="58" x2="50" y2="8" stroke="#fbbf24" stroke-width="3.5" stroke-linecap="round" />
            <line x1="6" y1="58" x2="17" y2="46" stroke="#fff" stroke-width="6" stroke-linecap="round" />
            <circle cx="18" cy="50" r="5" fill="#bfdbfe" stroke="#fff" stroke-width="1.5" />
          </svg>
          <span class="cta-line"><span class="cta-lure"></span></span>
        </span>
        <span class="cta-text">
          <strong>Do you want to reel in the experience?</strong>
          <span>Cast the line and follow it down ↓</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .stage {
    min-height: calc(100svh - var(--header-h));
    display: grid; align-items: center;
    padding: 3rem 0 4rem;
    position: relative; overflow: hidden;
    /* pânză albă cu puncte, ca un canvas de iPaaS */
    background-color: #fff;
    background-image: radial-gradient(#e2e8f0 1.3px, transparent 1.4px);
    background-size: 26px 26px;
  }
  .stage-grid { display: grid; gap: 4rem; align-items: center; position: relative; }
  @media (min-width: 960px) {
    /* scena e mai lată decât restul paginii, ca să încapă conectorii */
    .stage-grid { max-width: 1320px; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 7rem; }
  }
  .left, .right { position: relative; z-index: 1; }

  /* ---- Conectori ---- */
  .flow { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  .conn-base { fill: none; stroke: none; }
  .conn-line {
    fill: none; stroke: #94a3b8; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
  }
  .conn-1 .conn-line { stroke: #7c3aed; }
  .conn-2 .conn-line { stroke: var(--accent); }
  .conn-3 .conn-line { stroke: var(--accent); stroke-dasharray: 1; }
  .arrow-head { fill: var(--accent); }
  .packet {
    position: absolute; left: 0; top: 0; z-index: 0; pointer-events: none;
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
    offset-path: path("M0 0"); offset-rotate: 0deg; offset-anchor: center;
    opacity: 0; animation: travel linear infinite backwards;
  }
  .packet-1 { background: #7c3aed; }
  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    10%, 88% { opacity: 0.9; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  /* Desenarea în ordine: conector 1 → card ERP → conector 2 → card Data → conector 3 → buton */
  :global(.flow-ready) .conn-line { animation: draw 0.7s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  :global(.flow-ready) .conn-1 .conn-line { animation-delay: 0.6s; }
  :global(.flow-ready) .conn-2 .conn-line { animation-delay: 1.45s; }
  :global(.flow-ready) .conn-3 .conn-line { animation-delay: 2.3s; }
  :global(.flow-ready) .conn-4 .conn-line { animation-delay: 3.05s; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes show { to { opacity: 0.9; } }

  .start-node { opacity: 0; }
  :global(.flow-ready) .start-node { animation: pop 0.5s 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
  @keyframes pop { from { opacity: 0; transform: var(--t) scale(0.3); } to { opacity: 1; transform: var(--t) scale(1); } }
  .start-dot { fill: #7c3aed; stroke: #fff; stroke-width: 3; }
  .start-play { fill: #fff; }
  .start-ring { fill: none; stroke: #7c3aed; stroke-width: 2; opacity: 0.5; transform-box: fill-box; transform-origin: center; animation: ring 2.2s ease-out infinite; }
  @keyframes ring { from { transform: scale(1); opacity: 0.5; } to { transform: scale(2.2); opacity: 0; } }

  .conn-label {
    position: absolute; z-index: 2; transform: translate(-50%, -50%);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; white-space: nowrap;
    padding: 0.15rem 0.5rem; border-radius: 999px; background: #fff;
    border: 1px solid var(--border); color: var(--muted); opacity: 0; pointer-events: none;
  }
  .conn-label-1 { color: #7c3aed; border-color: #ddd6fe; }
  .conn-label-2 { color: var(--accent); border-color: #bfdbfe; }
  :global(.flow-ready) .conn-label { animation: show-label 0.4s forwards; }
  :global(.flow-ready) .conn-label-1 { animation-delay: 1.05s; }
  :global(.flow-ready) .conn-label-2 { animation-delay: 1.9s; }
  @keyframes show-label { to { opacity: 1; } }
  @media (max-width: 959px) { .conn-label { display: none; } }

  /* ---- Poza ---- */
  .photo-wrap { position: relative; max-width: 400px; width: 100%; margin: 0 auto; }
  .photo-wrap::before {
    content: ""; position: absolute; inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border-radius: 28px; z-index: -1;
    background: linear-gradient(135deg, #7c3aed, var(--work), var(--education));
    opacity: 0.2;
  }
  .photo {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: 28px; background: var(--surface);
    box-shadow: 0 30px 60px -30px rgba(15, 23, 42, 0.45);
  }
  @media (max-width: 959px) { .photo-wrap { max-width: 280px; } }
  /* pe desktop poza stă lipită în stânga, nu centrată în coloană */
  @media (min-width: 960px) { .photo-wrap { margin: 0; } }

  .now {
    position: absolute; left: 1rem; right: 1rem; bottom: -1.5rem;
    display: flex; gap: 0.75rem; align-items: flex-start;
    background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border); border-radius: 16px; padding: 0.8rem 1rem;
    box-shadow: 0 16px 36px -20px rgba(15, 23, 42, 0.45);
  }
  .now > div { display: flex; flex-direction: column; min-width: 0; }
  .now .label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
  .now strong { font-size: 0.98rem; line-height: 1.3; }
  .now .co { color: var(--accent); font-weight: 600; font-size: 0.85rem; }
  .live { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--education); margin-top: 0.3rem; flex-shrink: 0; }
  .live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--education); animation: live 2s ease-out infinite; }
  @keyframes live { from { transform: scale(1); opacity: 0.6; } to { transform: scale(3); opacity: 0; } }

  /* ---- Dreapta ---- */
  .eyebrow { color: var(--accent); margin: 0; font-weight: 600; }
  .stage-grid { row-gap: 3rem; }
  .name { font-size: clamp(2.5rem, 6.5vw, 4.25rem); line-height: 1.02; margin: 0.25rem 0 0.75rem; letter-spacing: -0.02em; }
  /* ---- Rândul de sus ---- */
  .intro { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 3rem; position: relative; z-index: 1; }
  @media (min-width: 960px) { .intro { grid-column: 1 / -1; } }
  .intro-text { min-width: 0; }
  .tagline { font-size: 1.15rem; color: var(--muted); margin: 0; max-width: 46ch; }
  .tagline .erp { color: #7c3aed; font-weight: 600; }
  .tagline .data { color: var(--accent); font-weight: 600; }

  /* motto-ul, cu o plută care se leagănă pe apă */
  .motto {
    position: relative; margin: 0; max-width: 24rem;
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.25rem; border-radius: 18px;
    background: linear-gradient(160deg, #eff6ff, #e0f2fe); border: 1px solid #bfdbfe;
    box-shadow: 0 16px 34px -24px rgba(37, 99, 235, 0.6);
  }
  .motto blockquote { margin: 0; font-style: italic; font-weight: 600; color: #1e3a8a; line-height: 1.4; }
  .bobber {
    position: relative; flex-shrink: 0; width: 22px; height: 34px;
    border-radius: 11px 11px 11px 11px / 14px 14px 20px 20px;
    background: linear-gradient(to bottom, #ef4444 0 48%, #fff 48% 100%);
    border: 2px solid #1e3a8a; animation: bob 2.2s ease-in-out infinite;
  }
  .bobber::before { content: ""; position: absolute; left: 50%; top: -10px; width: 2px; height: 10px; background: #1e3a8a; transform: translateX(-50%); }
  .bobber-ripple {
    position: absolute; left: 50%; bottom: -6px; width: 34px; height: 8px; margin-left: -17px;
    border: 2px solid rgba(37, 99, 235, 0.45); border-radius: 50%;
    animation: ripple 2.2s ease-out infinite;
  }
  @keyframes bob { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(5px) rotate(4deg); } }
  @keyframes ripple { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(1.6); opacity: 0; } }
  .motto:hover .bobber { animation-duration: 0.5s; }

  /* cardurile de rol se înclină după mouse */
  .tilt { perspective: 900px; }
  .tilt :global(.win) { transition: transform 0.25s ease-out, box-shadow 0.25s; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); }
  .tilt:hover :global(.win) { box-shadow: 0 26px 50px -26px rgba(15, 23, 42, 0.55); }

  .roles { display: grid; gap: 3.5rem; align-items: start; }
  @media (min-width: 640px) { .roles { grid-template-columns: 1fr 1fr; gap: 5.5rem; } }
  .step { position: relative; z-index: 1; }

  /* ---- About (nod în flux) ---- */
  .about {
    margin-top: 3.5rem; padding: 1.25rem 1.4rem; border-radius: 16px;
    background: rgba(255, 255, 255, 0.94); border: 1px solid var(--border);
    box-shadow: 0 18px 40px -26px rgba(15, 23, 42, 0.45);
  }
  .about-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--accent); }
  .about p { margin: 0.4rem 0 0; font-size: 0.95rem; color: #334155; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin: 1rem 0 0; }
  @media (min-width: 560px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats div { display: flex; flex-direction: column-reverse; background: #f1f5f9; border-radius: 10px; padding: 0.5rem 0.75rem; }
  .stats dd { margin: 0; font-size: 1.3rem; font-weight: 700; line-height: 1.2; }
  .stats dt { color: var(--muted); font-size: 0.78rem; }

  /* ---- Butonul-undiță ---- */
  .reel-cta {
    position: relative; z-index: 1; margin-top: 3rem;
    display: inline-flex; align-items: center; gap: 1rem;
    padding: 0.7rem 1.5rem 0.7rem 0.9rem; border-radius: 999px;
    background: linear-gradient(135deg, #1e40af, #2563eb 55%, #0ea5e9); color: #fff;
    box-shadow: 0 16px 34px -14px rgba(37, 99, 235, 0.75);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .reel-cta:hover { text-decoration: none; transform: translateY(-2px); box-shadow: 0 22px 40px -14px rgba(37, 99, 235, 0.85); }
  .cta-rod { position: relative; width: 44px; height: 44px; flex-shrink: 0; transform-origin: 6px 58px; }
  .cta-rod svg { display: block; transform-origin: 10% 90%; animation: rod-bob 2.4s ease-in-out infinite; }
  .reel-cta:hover .cta-rod svg { animation-duration: 0.6s; }
  @keyframes rod-bob { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-7deg); } }
  /* firul și momeala atârnă din vârful undiței */
  .cta-line {
    position: absolute; left: 34px; top: 6px; width: 1.5px; height: 30px; background: rgba(255, 255, 255, 0.85);
    transform-origin: top; animation: dangle 1.8s ease-in-out infinite;
  }
  .cta-lure { position: absolute; left: 50%; bottom: -5px; width: 8px; height: 8px; border-radius: 50%; transform: translateX(-50%); background: #f472b6; box-shadow: 0 0 0 2px #fff; }
  @keyframes dangle { 0%, 100% { transform: rotate(10deg); height: 26px; } 50% { transform: rotate(-10deg); height: 34px; } }
  .cta-text { display: flex; flex-direction: column; line-height: 1.25; }
  .cta-text strong { font-size: 1.05rem; }
  .cta-text span { font-size: 0.82rem; opacity: 0.85; }

  /* ---- Intrare în cascadă ---- */
  :global(.js) .enter { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: var(--d, 0ms); }
  :global(.js) .photo-wrap.enter { animation-name: photo-in; animation-duration: 0.9s; }
  :global(.js) .step.enter { animation-name: step-in; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes photo-in { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  @keyframes step-in { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .packet, .start-ring, .live::after { display: none; }
    :global(.flow-ready) .conn-line { animation-duration: 0s; animation-delay: 0s !important; }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>("[data-flow]");
  if (grid) {
    const svg = grid.querySelector<SVGSVGElement>("[data-flow-svg]")!;
    const node = (n: string) => grid.querySelector<HTMLElement>(`[data-node="${n}"]`)!;

    // Poziția unui element față de grilă, ignorând transformările animațiilor de intrare
    function box(el: HTMLElement) {
      let x = 0, y = 0, cur: HTMLElement | null = el;
      while (cur && cur !== grid) {
        x += cur.offsetLeft; y += cur.offsetTop;
        cur = cur.offsetParent as HTMLElement | null;
      }
      const w = el.offsetWidth, h = el.offsetHeight;
      return { left: x, top: y, right: x + w, bottom: y + h, cx: x + w / 2, cy: y + h / 2 };
    }

    // Linie ortogonală cu colțuri rotunjite (ca în editoarele iPaaS)
    function elbow(pts: [number, number][], r = 14) {
      let d = `M${pts[0][0]} ${pts[0][1]}`;
      for (let i = 1; i < pts.length - 1; i++) {
        const [px, py] = pts[i - 1], [x, y] = pts[i], [nx, ny] = pts[i + 1];
        const r1 = Math.min(r, Math.hypot(x - px, y - py) / 2, Math.hypot(nx - x, ny - y) / 2);
        const ax = x - Math.sign(x - px) * r1, ay = y - Math.sign(y - py) * r1;
        const bx = x + Math.sign(nx - x) * r1, by = y + Math.sign(ny - y) * r1;
        d += ` L${ax} ${ay} Q${x} ${y} ${bx} ${by}`;
      }
      const last = pts[pts.length - 1];
      return d + ` L${last[0]} ${last[1]}`;
    }

    type B = ReturnType<typeof box>;
    // Alege traseul: orizontal dacă ținta e în dreapta, altfel vertical (pe telefon)
    function route(a: B, b: B, ay?: number): { pts: [number, number][]; mid: [number, number] } {
      if (b.left >= a.right - 4) {
        const sx = a.right, sy = ay ?? a.cy, tx = b.left - 6, ty = b.cy;
        const mx = (sx + tx) / 2;
        // eticheta stă deasupra liniei, nu peste ea
        return { pts: [[sx, sy], [mx, sy], [mx, ty], [tx, ty]], mid: [mx, Math.min(sy, ty) - 18] };
      }
      const sx = a.cx, sy = a.bottom, tx = b.cx, ty = b.top - 6;
      const my = (sy + ty) / 2;
      return { pts: [[sx, sy], [sx, my], [tx, my], [tx, ty]], mid: [(sx + tx) / 2, my - 16] };
    }

    function layout() {
      svg.setAttribute("viewBox", `0 0 ${grid!.offsetWidth} ${grid!.offsetHeight}`);
      const photo = box(node("photo").querySelector(".photo") as HTMLElement);
      const now = box(node("photo").querySelector(".now") as HTMLElement);
      const erp = box(node("erp").querySelector(".win") as HTMLElement);
      const data = box(node("data").querySelector(".win") as HTMLElement);
      const dataFig = box(node("data"));
      const cta = box(node("cta"));

      // conectorul 1 pleacă de pe marginea pozei, la înălțimea cardului ERP (cât se poate);
      // pe telefon (unul sub altul) pleacă de sub cardul „Currently”
      const y1 = Math.min(Math.max(erp.cy, photo.top + 40), photo.bottom - 80);
      // +20px: pornim de pe marginea chenarului colorat din spatele pozei, ca nodul să fie vizibil
      const c1 = route({ ...photo, right: photo.right + 20, bottom: now.bottom }, erp, y1);
      const c2 = route(erp, data);
      // conectorul 3: din cardul Data (sub legendă) coboară drept în About
      const about = box(node("about"));
      const c3 = { pts: [[data.cx, dataFig.bottom + 6], [data.cx, about.top - 6]] as [number, number][] };
      // conectorul 4: din About coboară în butonul-undiță
      const x4 = Math.min(Math.max(cta.cx, about.left + 30), about.right - 30);
      const c4 = { pts: [[x4, about.bottom], [x4, cta.top - 6]] as [number, number][] };

      [c1, c2, c3, c4].forEach((c, i) => {
        const d = elbow(c.pts);
        svg.querySelectorAll(`.conn-${i + 1} path`).forEach((p) => p.setAttribute("d", d));
        grid!.querySelectorAll<HTMLElement>(`[data-packet="${i + 1}"]`).forEach((p) => (p.style.offsetPath = `path("${d}")`));
      });

      // nodul „Start” stă pe marginea pozei
      const [sx, sy] = c1.pts[0];
      const start = svg.querySelector<SVGGElement>("[data-start-node]")!;
      start.style.setProperty("--t", `translate(${sx}px, ${sy}px)`);
      start.style.transform = `translate(${sx}px, ${sy}px)`;

      // etichetele „since 2021 / 2024” pe conectori
      [c1, c2].forEach((c, i) => {
        const lbl = grid!.querySelector<HTMLElement>(`[data-label="${i + 1}"]`)!;
        lbl.style.left = `${c.mid[0]}px`;
        lbl.style.top = `${c.mid[1]}px`;
      });
    }

    // înclinare 3D ușoară a cardurilor de rol, după poziția mouse-ului
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      grid.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
        el.addEventListener("pointermove", (e) => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          el.style.setProperty("--ry", `${x * 10}deg`);
          el.style.setProperty("--rx", `${-y * 8}deg`);
        });
        el.addEventListener("pointerleave", () => { el.style.setProperty("--rx", "0deg"); el.style.setProperty("--ry", "0deg"); });
      });
    }

    layout();
    requestAnimationFrame(() => grid.classList.add("flow-ready"));
    new ResizeObserver(layout).observe(grid);
    document.fonts?.ready.then(layout);
    grid.querySelector("img")?.addEventListener("load", layout);
  }
</script>
