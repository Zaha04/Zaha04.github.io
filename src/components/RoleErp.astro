---
// „Imaginea” pentru ERP Consultant: o fereastră ERP stilizată, animată
const rows = [
  { doc: "REST API", kind: "IFS → SAP" },
  { doc: "Migration", kind: "Customers" },
  { doc: "PL/SQL", kind: "SAF-T report" },
];
---

<figure class="role">
  <div class="win" aria-hidden="true">
    <div class="bar"><i></i><i></i><i></i><span>ERP · Technical</span></div>
    <div class="body">
      <ul class="mods">
        <li class="on">Integrations</li>
        <li>Migrations</li>
        <li>Reports</li>
        <li>Custom APIs</li>
      </ul>
      <div class="rows">
        {rows.map((r, i) => (
          <div class="row" style={`--i:${i}`}>
            <span class="doc">{r.doc}</span>
            <span class="kind">{r.kind}</span>
            <span class="status">
              <span class="pending">Running</span>
              <span class="sent">Done ✓</span>
            </span>
          </div>
        ))}
        <div class="sync"><span class="sync-dot"></span>Boomi sync running</div>
      </div>
    </div>
  </div>
  <figcaption>
    <strong>IFS ERP Consultant / Data Integration</strong>
    <span>IFS · Boomi · Oracle · PL/SQL</span>
  </figcaption>
</figure>

<style>
  .role { margin: 0; }
  .win {
    border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: #fff;
    box-shadow: 0 18px 40px -26px rgba(15, 23, 42, 0.45);
    font-size: 10.5px; line-height: 1.3;
  }
  .bar { display: flex; align-items: center; gap: 4px; padding: 6px 8px; background: #f1f5f9; border-bottom: 1px solid var(--border); }
  .bar i { width: 7px; height: 7px; border-radius: 50%; background: #cbd5e1; }
  .bar i:first-child { background: #f87171; } .bar i:nth-child(2) { background: #fbbf24; } .bar i:nth-child(3) { background: #34d399; }
  .bar span { margin-left: 6px; color: var(--muted); font-weight: 600; }
  .body { display: grid; grid-template-columns: 76px 1fr; min-height: 128px; }
  .doc, .kind, .status > span { white-space: nowrap; }
  .kind { font-size: 9.5px; }
  .mods { list-style: none; margin: 0; padding: 8px 6px; background: #faf5ff; border-right: 1px solid var(--border); }
  .mods li { padding: 4px 5px; border-radius: 5px; color: #6b21a8; font-size: 9.5px; }
  .mods li.on { background: #7c3aed; color: #fff; font-weight: 600; }
  .rows { padding: 8px; display: grid; gap: 6px; align-content: start; }
  .row { display: grid; grid-template-columns: auto 1fr auto; gap: 6px; align-items: center; padding: 5px 6px; border: 1px solid var(--border); border-radius: 6px; }
  .doc { font-weight: 600; font-variant-numeric: tabular-nums; }
  .kind { color: var(--muted); }
  .status { display: grid; }
  .status > span { grid-area: 1 / 1; padding: 1px 6px; border-radius: 999px; font-weight: 600; text-align: center; }
  .pending { background: #fef3c7; color: #78350f; animation: pend 6s infinite; animation-delay: calc(var(--i) * 0.8s); }
  .sent { background: #d1fae5; color: #064e3b; animation: sent 6s infinite; animation-delay: calc(var(--i) * 0.8s); }
  /* schimbare Running → Done fără transparență (textul rămâne mereu lizibil) */
  @keyframes pend { 0%, 34% { visibility: visible; } 35%, 99% { visibility: hidden; } 100% { visibility: visible; } }
  @keyframes sent { 0%, 34% { visibility: hidden; transform: scale(0.8); } 35% { visibility: visible; transform: scale(1.1); } 42%, 99% { visibility: visible; transform: none; } 100% { visibility: hidden; } }
  .sync { display: flex; align-items: center; gap: 6px; color: var(--muted); margin-top: 2px; }
  .sync-dot { width: 7px; height: 7px; border-radius: 50%; background: #7c3aed; animation: blink 1.2s infinite; }
  @keyframes blink { 50% { opacity: 0.25; } }

  figcaption { display: flex; flex-direction: column; margin-top: 0.6rem; }
  figcaption strong { font-size: 1rem; }
  figcaption span { color: var(--muted); font-size: 0.82rem; }

  @media (prefers-reduced-motion: reduce) {
    .pending { visibility: hidden; } .sent { visibility: visible; }
  }
</style>
